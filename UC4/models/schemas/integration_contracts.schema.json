{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://salus-project.eu/schemas/t43/integration_contracts.schema.json",
  "title": "SALUS UC4 Integration Contract Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_set_id", "use_case", "compatibility_policy", "contracts"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "contract_set_id": {"const": "UC4-INTEGRATION-CONTRACTS-001"},
    "use_case": {"const": "UC4"},
    "compatibility_policy": {"type": "string", "minLength": 1},
    "contracts": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/contract"}
    }
  },
  "$defs": {
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message_id", "direction", "schema_ref", "required_fields", "semantics"],
      "properties": {
        "message_id": {"type": "string", "pattern": "^UC4-ICM-[0-9]{3}$"},
        "direction": {"enum": ["inbound", "outbound", "bidirectional"]},
        "schema_ref": {"type": ["string", "null"]},
        "required_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "semantics": {"type": "string", "minLength": 1}
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id", "partner_task", "name", "applicability", "boundary",
        "transport", "endpoint_status", "messages", "authorization",
        "failure_semantics", "assumption_ids", "replacement_procedure"
      ],
      "properties": {
        "contract_id": {"type": "string", "pattern": "^UC4-IC-[0-9]{2}$"},
        "partner_task": {"enum": ["T4.4", "T4.2", "T3.3", "T3.4", "T3.5", "T3.1/T3.6", "WP6-UC4"]},
        "name": {"type": "string", "minLength": 1},
        "applicability": {"enum": ["implemented_internal", "abstract_adapter", "disabled_by_default", "pilot_replacement"]},
        "boundary": {"type": "string", "minLength": 1},
        "transport": {"type": "string", "minLength": 1},
        "endpoint_status": {"enum": ["implemented", "abstract", "TBD", "disabled"]},
        "messages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/message"}},
        "authorization": {"type": "string", "minLength": 1},
        "failure_semantics": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "assumption_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^ASSUMPTION-UC4-[0-9]{3}$"}},
        "replacement_procedure": {"type": "string", "minLength": 1}
      }
    }
  }
}
