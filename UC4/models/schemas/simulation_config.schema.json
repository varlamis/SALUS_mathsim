{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://salus-project.eu/schemas/mathsim/simulation_config.schema.json",
  "title": "SALUS UC4 Simulation Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "deterministic", "random_seed", "time", "topology", "devices", "incident", "authorization", "observation", "network", "collection", "retention", "digital_twin", "reconstruction", "outputs"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "scenario_id": { "type": "string", "const": "UC4-unauthorized-entry-sensor-tampering" },
    "deterministic": { "type": "boolean" },
    "random_seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "time": {
      "type": "object", "additionalProperties": false,
      "required": ["unit", "horizon", "warmup", "entry", "tamper", "case_trigger", "request"],
      "properties": {
        "unit": { "type": "string", "const": "seconds" },
        "horizon": { "type": "number", "exclusiveMinimum": 0 },
        "warmup": { "type": "number", "minimum": 0 },
        "entry": { "type": "number", "minimum": 0 },
        "tamper": { "type": "number", "minimum": 0 },
        "case_trigger": { "type": "number", "minimum": 0 },
        "request": { "type": "number", "minimum": 0 }
      }
    },
    "topology": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled_entities", "cloud_enabled", "sdn_enabled"],
      "properties": {
        "enabled_entities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^UC4(?:-[A-Z]{1,3}[0-9]{2})?$" } },
        "cloud_enabled": { "type": "boolean", "default": false },
        "sdn_enabled": { "type": "boolean", "default": false }
      }
    },
    "devices": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^UC4-D0[1-6]$" },
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["enabled", "processing_delay_seconds", "error_probability", "clock_offset_seconds", "transition_parameters"],
        "properties": {
          "enabled": { "type": "boolean" },
          "processing_delay_seconds": { "type": "number", "minimum": 0 },
          "error_probability": { "type": "number", "minimum": 0, "maximum": 1 },
          "clock_offset_seconds": { "type": "number" },
          "transition_parameters": { "type": "object" }
        }
      }
    },
    "incident": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "entry_entity", "tamper_target", "tamper_strategy", "light_automation_enabled", "home_assistant_automation_delay_seconds", "light_acknowledgement_delay_seconds"],
      "properties": {
        "enabled": { "type": "boolean" },
        "entry_entity": { "type": "string", "const": "UC4-D03" },
        "tamper_target": { "type": "string", "const": "UC4-D03" },
        "tamper_strategy": { "type": "string", "enum": ["tampered_then_offline", "direct_offline"] },
        "light_automation_enabled": { "type": "boolean" },
        "home_assistant_automation_delay_seconds": { "type": "number", "minimum": 0 },
        "light_acknowledgement_delay_seconds": { "type": "number", "minimum": 0 }
      }
    },
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["decision_path", "authorization_id", "case_id", "purpose", "valid_from", "valid_to", "evidence_window_start", "evidence_window_end", "allowed_entities", "allowed_data_types", "allowed_actions", "permitted_fields", "verification_result"],
      "properties": {
        "decision_path": { "type": "string", "enum": ["allow", "absent", "invalid", "expired", "revoked", "out_of_scope"] },
        "authorization_id": { "type": "string", "pattern": "^UC4-AUTH-[0-9]{4}$" },
        "case_id": { "type": "string", "pattern": "^UC4-CASE-[0-9]{4}$" },
        "purpose": { "type": "string", "minLength": 1 },
        "valid_from": { "type": "number", "minimum": 0 },
        "valid_to": { "type": "number", "exclusiveMinimum": 0 },
        "evidence_window_start": { "type": "number", "minimum": 0 },
        "evidence_window_end": { "type": "number", "minimum": 0 },
        "allowed_entities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^UC4-D0[1-6]$" } },
        "allowed_data_types": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "allowed_actions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["read_historical", "observe_live", "export_metadata", "export_state"] } },
        "permitted_fields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "verification_result": { "type": "string", "enum": ["valid", "invalid", "unknown"] }
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["base_loss_probability", "presence_detection_probability", "presence_false_positive_probability", "presence_evaluation_window_seconds", "presence_reporting_delay_seconds", "presence_refractory_seconds", "clock_offset_bound_seconds", "timestamp_jitter_std_seconds", "timestamp_jitter_bound_seconds"],
      "properties": {
        "base_loss_probability": { "type": "number", "minimum": 0, "maximum": 1 },
        "presence_detection_probability": { "type": "number", "minimum": 0, "maximum": 1 },
        "presence_false_positive_probability": { "type": "number", "minimum": 0, "maximum": 1 },
        "presence_evaluation_window_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "presence_reporting_delay_seconds": { "type": "number", "minimum": 0 },
        "presence_refractory_seconds": { "type": "number", "minimum": 0 },
        "clock_offset_bound_seconds": { "type": "number", "minimum": 0 },
        "timestamp_jitter_std_seconds": { "type": "number", "minimum": 0 },
        "timestamp_jitter_bound_seconds": { "type": "number", "minimum": 0 }
      }
    },
    "network": {
      "type": "object", "additionalProperties": false,
      "required": ["service_capacity_bits_per_second", "buffer_bytes", "base_delay_seconds", "jitter_bound_seconds", "loss_probability", "logging_enabled", "payload_capture_enabled"],
      "properties": {
        "service_capacity_bits_per_second": { "type": "number", "exclusiveMinimum": 0 },
        "buffer_bytes": { "type": "integer", "minimum": 1 },
        "base_delay_seconds": { "type": "number", "minimum": 0 },
        "jitter_bound_seconds": { "type": "number", "minimum": 0 },
        "loss_probability": { "type": "number", "minimum": 0, "maximum": 1 },
        "logging_enabled": { "type": "boolean" },
        "payload_capture_enabled": { "type": "boolean", "const": false },
        "background_load_fraction": { "type": "number", "minimum": 0, "exclusiveMaximum": 1, "default": 0 }
      }
    },
    "collection": {
      "type": "object", "additionalProperties": false,
      "required": ["minimization_enabled", "pseudonymization_enabled", "acquisition_timeout_seconds", "allowed_sources_only", "deny_empty_projection", "retention_policy"],
      "properties": {
        "minimization_enabled": { "type": "boolean", "const": true },
        "pseudonymization_enabled": { "type": "boolean", "const": true },
        "acquisition_timeout_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "allowed_sources_only": { "type": "boolean", "const": true },
        "deny_empty_projection": { "type": "boolean", "const": true },
        "retention_policy": { "type": "string", "enum": ["bounded_case_retention", "dispose_at_run_end"] },
        "start_delay_seconds": { "type": "number", "minimum": 0, "default": 0 }
      }
    },
    "retention": {
      "type": "object", "additionalProperties": false,
      "required": ["home_assistant_max_events", "cpe_max_bytes", "nominal_seconds"],
      "properties": {
        "home_assistant_max_events": { "type": "integer", "minimum": 1 },
        "cpe_max_bytes": { "type": "integer", "minimum": 1 },
        "nominal_seconds": { "type": "number", "minimum": 0 }
      }
    },
    "digital_twin": {
      "type": "object", "additionalProperties": false,
      "required": ["stale_threshold_seconds"],
      "properties": {
        "stale_threshold_seconds": { "type": "number", "minimum": 0 }
      }
    },
    "reconstruction": {
      "type": "object", "additionalProperties": false,
      "required": ["missing_evidence_penalty", "support_weights", "source_reliability"],
      "properties": {
        "missing_evidence_penalty": { "type": "number", "minimum": 0, "maximum": 1 },
        "support_weights": {
          "type": "object", "minProperties": 1,
          "additionalProperties": { "type": "number", "minimum": 0 }
        },
        "source_reliability": {
          "type": "object", "minProperties": 1,
          "propertyNames": { "pattern": "^UC4(?:-[A-Z]{1,3}[0-9]{2})?$" },
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "faults": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "force_presence_miss": { "type": "boolean", "default": false },
        "force_door_observation_loss": { "type": "boolean", "default": false },
        "evidence_tamper_after_collection": { "type": "boolean", "default": false },
        "custody_tamper_after_append": { "type": "boolean", "default": false },
        "home_assistant_unavailable": { "type": "boolean", "default": false },
        "cpe_unavailable": { "type": "boolean", "default": false }
      }
    },
    "outputs": {
      "type": "object", "additionalProperties": false,
      "required": ["directory", "canonicalization", "include_ground_truth"],
      "properties": {
        "directory": { "type": "string", "minLength": 1 },
        "canonicalization": { "type": "string", "const": "RFC8785-JCS" },
        "include_ground_truth": { "type": "boolean" }
      }
    }
  }
}
