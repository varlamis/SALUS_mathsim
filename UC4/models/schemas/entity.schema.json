{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://salus-project.eu/schemas/mathsim/entity.schema.json",
  "title": "SALUS mathematical simulation Canonical Entity",
  "description": "Canonical representation of a physical, digital, human, organizational, environmental, data, policy, or service entity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entity_id",
    "use_case",
    "name",
    "entity_class",
    "parent_class",
    "designation",
    "owner_operator",
    "location",
    "network_zones",
    "role",
    "lifecycle",
    "capabilities",
    "interfaces",
    "data",
    "provenance",
    "sensitivity",
    "retention_class",
    "observability"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "entity_id": { "type": "string", "pattern": "^UC4(?:-[A-Z]{1,3}[0-9]{2})?$" },
    "use_case": { "type": "string", "const": "UC4" },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "entity_class": {
      "type": "string",
      "enum": [
        "UseCase", "PhysicalEnvironment", "NetworkZone", "Gateway", "GatewayServer",
        "Sensor", "SensorActuator", "Actuator", "TwinEntity", "CloudService",
        "ForensicsService", "DigitalTwinService", "HumanActor", "LEAUser",
        "HumanOrganisationActor", "OrganisationSystemActor", "SystemActor",
        "PolicyDataObject", "NetworkFlowLogEntry", "EventLogEntry", "EventTelemetry",
        "EvidenceItem", "Alert", "PolicyDecision", "CustodyEvent", "AnalysisResult"
      ]
    },
    "parent_class": { "type": "string", "minLength": 1 },
    "designation": { "type": "string", "enum": ["physical", "digital", "logical"] },
    "owner_operator": { "type": "string", "minLength": 1 },
    "location": { "type": "string", "minLength": 1 },
    "network_zones": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^UC4-NZ[0-9]{2}$" }
    },
    "role": { "type": "string", "minLength": 1 },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_state", "allowed_states"],
      "properties": {
        "initial_state": { "type": "string", "minLength": 1 },
        "allowed_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "direction", "protocol", "status"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["physical", "network", "application", "policy", "storage", "simulation", "human"] },
          "direction": { "type": "string", "enum": ["in", "out", "bidirectional"] },
          "protocol": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["confirmed", "abstract", "proposed", "TBD", "disabled"] }
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generates", "consumes"],
      "properties": {
        "generates": { "$ref": "#/$defs/entityReferences" },
        "consumes": { "$ref": "#/$defs/entityReferences" }
      }
    },
    "twin_id": { "type": "string", "pattern": "^UC4-DT[0-9]{2}$" },
    "physical_entity_id": { "type": "string", "pattern": "^UC4-D[0-9]{2}$" },
    "clock_domain": { "type": "string", "minLength": 1 },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_references", "record_status", "confidence", "assumption_ids"],
      "properties": {
        "source_references": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "record_status": { "type": "string", "enum": ["proposal", "roadmap", "agreed_decision", "assumed", "proposed", "TBD"] },
        "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
        "assumption_ids": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "pattern": "^ASSUMPTION-UC4-[0-9]{3}$" }
        }
      }
    },
    "sensitivity": { "type": "string", "enum": ["Low", "Medium", "High", "Critical"] },
    "retention_class": { "type": "string", "enum": ["none", "configuration", "scenario", "bounded_source", "run_retention", "case_retention", "restricted_truth", "external_TBD"] },
    "observability": { "type": "string", "enum": ["observable", "partially_observable", "latent", "derived_observable", "fully_audited", "audited_interface", "read_only_audited", "policy_visible", "collector_if_authorized", "authorized_access_only", "investigator_visible", "evidence_only", "not_observable_when_disabled"] },
    "notes": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "entity_class": { "const": "TwinEntity" } }, "required": ["entity_class"] },
      "then": { "required": ["physical_entity_id", "clock_domain"] }
    },
    {
      "if": { "properties": { "entity_id": { "pattern": "^UC4-D[0-9]{2}$" } }, "required": ["entity_id"] },
      "then": { "required": ["twin_id", "clock_domain"] }
    }
  ],
  "$defs": {
    "entityReferences": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^UC4(?:-[A-Z]{1,3}[0-9]{2})?$" }
    }
  }
}
