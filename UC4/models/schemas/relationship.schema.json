{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://salus-project.eu/schemas/t43/relationship.schema.json",
  "title": "SALUS T4.3 Canonical Relationship",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "relationship_id", "use_case", "source_entity", "target_entity",
    "relationship_type", "description", "valid_from", "valid_to", "confidence",
    "record_status", "source_references", "assumption_ids", "attributes"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "relationship_id": { "type": "string", "pattern": "^UC4-REL-[0-9]{3}$" },
    "use_case": { "type": "string", "const": "UC4" },
    "source_entity": { "type": "string", "pattern": "^UC4(?:-[A-Z]{1,3}[0-9]{2})?$" },
    "target_entity": { "type": "string", "pattern": "^UC4(?:-[A-Z]{1,3}[0-9]{2})?$" },
    "relationship_type": {
      "type": "string",
      "enum": [
        "BELONGS_TO_USE_CASE", "PART_OF", "DEPLOYED_IN", "MEMBER_OF_ZONE", "OWNED_BY",
        "COMMUNICATES_WITH", "ROUTES_THROUGH", "USES_INTERFACE", "GENERATES", "CONSUMES",
        "OBSERVED_BY", "COLLECTED_BY", "PRODUCES_EVIDENCE", "DERIVED_FROM", "AUTHORIZED_BY",
        "REQUESTED_BY", "ACCESSED_BY", "CUSTODIED_BY", "MIRRORED_BY", "SYNCHRONIZES_WITH",
        "TRIGGERS", "AFFECTS", "CORRELATES_WITH", "PROTECTED_BY", "VIOLATES_POLICY", "CONTROLLED_BY"
      ]
    },
    "description": { "type": "string", "minLength": 1 },
    "valid_from": { "type": ["number", "null"], "minimum": 0 },
    "valid_to": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "record_status": { "type": "string", "enum": ["proposal", "roadmap", "agreed_decision", "assumed", "proposed", "TBD"] },
    "source_references": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "assumption_ids": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^ASSUMPTION-UC4-[0-9]{3}$" }
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface", "protocol", "authorization_relevance", "data_types"],
      "properties": {
        "interface": { "type": "string" },
        "protocol": { "type": "string" },
        "authorization_relevance": { "type": "string", "enum": ["none", "context", "in_scope_required", "policy_enforced"] },
        "data_types": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    }
  }
}
