{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://salus-project.eu/schemas/mathsim/event.schema.json",
  "title": "SALUS mathematical simulation Canonical Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "use_case", "event_time", "ingest_time", "source_entity", "event_type", "payload", "correlation_ids", "provenance", "visibility"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "event_id": { "type": "string", "pattern": "^UC4-EVT-[A-Z0-9-]+$" },
    "use_case": { "type": "string", "const": "UC4" },
    "event_time": { "type": "number", "minimum": 0 },
    "ingest_time": { "type": "number", "minimum": 0 },
    "source_entity": { "type": "string", "pattern": "^UC4(?:-[A-Z]{1,3}[0-9]{2})?$" },
    "target_entity": { "type": ["string", "null"], "pattern": "^UC4(?:-[A-Z]{1,3}[0-9]{2})?$" },
    "event_type": { "type": "string", "minLength": 1 },
    "payload": { "type": "object" },
    "correlation_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source_record_id", "sequence", "clock_domain", "quality"],
      "properties": {
        "source_record_id": { "type": ["string", "null"] },
        "sequence": { "type": "integer", "minimum": 0 },
        "clock_domain": { "type": "string", "minLength": 1 },
        "quality": { "type": "string", "enum": ["exact", "estimated", "delayed", "partial", "missing_marker"] }
      }
    },
    "visibility": { "type": "string", "enum": ["ground_truth_only", "observable", "collected", "investigator_visible"] }
  }
}
