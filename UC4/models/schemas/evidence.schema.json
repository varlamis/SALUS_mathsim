{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://salus-project.eu/schemas/t43/evidence.schema.json",
  "title": "SALUS T4.3 Canonical Evidence Item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evidence_id", "use_case", "source_entity", "source_record_ids",
    "authorization_id", "policy_decision_id", "acquisition_method", "source_time_range",
    "acquisition_time", "content_hash", "canonicalization", "collector_id", "sensitivity",
    "transformations", "custody_status", "storage_reference"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "evidence_id": { "type": "string", "pattern": "^UC4-EV-[0-9]{6}$" },
    "use_case": { "type": "string", "const": "UC4" },
    "source_entity": { "type": "string", "pattern": "^UC4(?:-[A-Z]{1,3}[0-9]{2})?$" },
    "source_record_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "authorization_id": { "type": "string", "pattern": "^UC4-AUTH-[0-9]{4}$" },
    "policy_decision_id": { "type": "string", "pattern": "^UC4-PD-[0-9]{6}$" },
    "acquisition_method": { "type": "string", "enum": ["cpe_historical", "cpe_live", "home_assistant_export", "device_state_export", "cloud_export"] },
    "source_time_range": {
      "type": "object", "additionalProperties": false, "required": ["start", "end"],
      "properties": { "start": { "type": "number", "minimum": 0 }, "end": { "type": "number", "minimum": 0 } }
    },
    "acquisition_time": { "type": "number", "minimum": 0 },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "canonicalization": { "type": "string", "const": "RFC8785-JCS" },
    "collector_id": { "type": "string", "const": "UC4-S02" },
    "sensitivity": { "type": "string", "enum": ["Low", "Medium", "High", "Critical"] },
    "transformations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["transformation_id", "type", "input_evidence_ids", "time", "actor_id"],
        "properties": {
          "transformation_id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["none", "minimize", "redact", "normalize", "derive"] },
          "input_evidence_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "time": { "type": "number", "minimum": 0 },
          "actor_id": { "type": "string", "pattern": "^UC4(?:-[A-Z]{1,3}[0-9]{2})?$" }
        }
      }
    },
    "custody_status": { "type": "string", "enum": ["registered", "verified", "verification_failed", "disposed"] },
    "storage_reference": { "type": "string", "minLength": 1 }
  }
}
