{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://salus-project.eu/schemas/t43/entity_collection.schema.json",
  "title": "SALUS T4.3 Entity Collection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "use_case", "source_inventory", "entities"],
  "properties": {
    "$schema": { "type": "string", "const": "../schemas/entity_collection.schema.json" },
    "schema_version": { "type": "string", "const": "1.0.0" },
    "use_case": { "type": "string", "const": "UC4" },
    "source_inventory": { "type": "string", "const": "data/inventory/uc4_entity_inventory.csv" },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "entity.schema.json" }
    }
  }
}
