{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://salus-project.eu/schemas/t43/artifact_manifest.schema.json",
  "title": "SALUS UC4 Final Artifact Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "use_case", "generator", "generated_at_utc", "hash_algorithm", "self_excluded", "artifact_count", "artifacts"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "use_case": {"const": "UC4"},
    "generator": {"type": "string", "pattern": "^salus-t43/[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "hash_algorithm": {"const": "SHA-256"},
    "self_excluded": {"const": true},
    "artifact_count": {"type": "integer", "minimum": 1},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
