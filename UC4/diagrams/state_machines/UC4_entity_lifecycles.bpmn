<?xml version="1.0" encoding="utf-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_UC4_Lifecycles" targetNamespace="https://salus-project.eu/mathsim/uc4/lifecycles">
  <bpmn:message id="Msg_Alert" name="Explainable alert" />
  <bpmn:message id="Msg_Acknowledge" name="Investigator acknowledgement" />
  <bpmn:message id="Msg_AuthRequest" name="Authorization submission" />
  <bpmn:message id="Msg_CasePreparation" name="Case request preparation" />
  <bpmn:message id="Msg_AuthDecision" name="Active or denied authorization" />
  <bpmn:message id="Msg_AuthTerminal" name="Expired or revoked authorization" />
  <bpmn:message id="Msg_Candidates" name="Authorized evidence candidates" />
  <bpmn:message id="Msg_Denial" name="Acquisition denial" />
  <bpmn:message id="Msg_EvidenceReady" name="Verified evidence manifest" />
  <bpmn:message id="Msg_Reconstruction" name="Reconstruction outcome" />
  <bpmn:signal id="Signal_RevokeAuthorization" name="Authorization revoked by issuer" />
  <bpmn:signal id="Signal_DeviceTamper" name="Configured device tamper action" />
  <bpmn:signal id="Signal_DeviceDisconnect" name="Device connectivity lost" />
  <bpmn:collaboration id="Collab_UC4_Lifecycles">
    <bpmn:participant id="Participant_External" name="External detection, authority and reconstruction triggers" />
    <bpmn:participant id="Participant_Case" name="Investigation case trigger lifecycle (UC4-DO06)" processRef="Process_Case" />
    <bpmn:participant id="Participant_Authorization" name="Authorization lifecycle (UC4-DO01)" processRef="Process_Authorization" />
    <bpmn:participant id="Participant_Acquisition" name="CPE lawful-acquisition lifecycle (UC4-S02 on UC4-D01)" processRef="Process_Acquisition" />
    <bpmn:participant id="Participant_Door" name="Door sensor lifecycle (UC4-D03)" processRef="Process_Door" />
    <bpmn:participant id="Participant_HA" name="Home Assistant connectivity lifecycle (UC4-D02)" processRef="Process_HA" />
    <bpmn:participant id="Participant_Evidence" name="Evidence item lifecycle (UC4-DO05)" processRef="Process_Evidence" />
    <bpmn:messageFlow id="MF_Alert" sourceRef="Participant_External" targetRef="Start_Case" />
    <bpmn:messageFlow id="MF_Acknowledge" sourceRef="Participant_External" targetRef="Catch_Acknowledge" />
    <bpmn:messageFlow id="MF_AuthRequest" sourceRef="Send_AuthRequest" targetRef="Start_Authorization" />
    <bpmn:messageFlow id="MF_CasePreparation" sourceRef="Send_CasePreparation" targetRef="Start_Acquisition" />
    <bpmn:messageFlow id="MF_AuthDecision" sourceRef="Send_AuthDecision" targetRef="Catch_AuthDecision" />
    <bpmn:messageFlow id="MF_AuthTerminal" sourceRef="Send_AuthTerminal" targetRef="Catch_AuthTerminal" />
    <bpmn:messageFlow id="MF_Candidates" sourceRef="Send_Candidates" targetRef="Start_Evidence" />
    <bpmn:messageFlow id="MF_Denial" sourceRef="Send_Denial" targetRef="Catch_CaseDenial" />
    <bpmn:messageFlow id="MF_EvidenceReady" sourceRef="Send_EvidenceReady" targetRef="Catch_EvidenceReady" />
    <bpmn:messageFlow id="MF_Reconstruction" sourceRef="Participant_External" targetRef="Catch_Reconstruction" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Case" isExecutable="false">
    <bpmn:startEvent id="Start_Case" name="Alert received">
      <bpmn:messageEventDefinition messageRef="Msg_Alert" />
    </bpmn:startEvent>
    <bpmn:task id="State_CaseCreated" name="[STATE] created - alert and supporting IDs fixed" />
    <bpmn:intermediateCatchEvent id="Catch_Acknowledge" name="Investigator acknowledges and assigns case ID">
      <bpmn:messageEventDefinition messageRef="Msg_Acknowledge" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="State_CaseAcknowledged" name="[STATE] acknowledged - collection still inactive" />
    <bpmn:parallelGateway id="GW_CaseSplit" name="Prepare authorization and acquisition request" />
    <bpmn:sendTask id="Send_AuthRequest" name="Submit authorization request" messageRef="Msg_AuthRequest" />
    <bpmn:sendTask id="Send_CasePreparation" name="Register request-preparation state" messageRef="Msg_CasePreparation" />
    <bpmn:parallelGateway id="GW_CaseJoin" />
    <bpmn:eventBasedGateway id="GW_CaseOutcome" name="Wait for acquisition outcome" />
    <bpmn:intermediateCatchEvent id="Catch_CaseDenial" name="Acquisition denied">
      <bpmn:messageEventDefinition messageRef="Msg_Denial" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_EvidenceReady" name="Verified evidence ready">
      <bpmn:messageEventDefinition messageRef="Msg_EvidenceReady" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_RecordEvidenceReady" name="Record evidence manifest; await reconstruction" />
    <bpmn:intermediateCatchEvent id="Catch_Reconstruction" name="Reconstruction received">
      <bpmn:messageEventDefinition messageRef="Msg_Reconstruction" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="State_CaseClosed" name="[STATE] closed - reason and outcome retained" />
    <bpmn:endEvent id="End_Case" name="Case-trigger lifecycle complete" />
    <bpmn:sequenceFlow id="F_Case1" sourceRef="Start_Case" targetRef="State_CaseCreated" />
    <bpmn:sequenceFlow id="F_Case2" sourceRef="State_CaseCreated" targetRef="Catch_Acknowledge" />
    <bpmn:sequenceFlow id="F_Case3" sourceRef="Catch_Acknowledge" targetRef="State_CaseAcknowledged" />
    <bpmn:sequenceFlow id="F_Case4" sourceRef="State_CaseAcknowledged" targetRef="GW_CaseSplit" />
    <bpmn:sequenceFlow id="F_Case5A" sourceRef="GW_CaseSplit" targetRef="Send_AuthRequest" />
    <bpmn:sequenceFlow id="F_Case5B" sourceRef="GW_CaseSplit" targetRef="Send_CasePreparation" />
    <bpmn:sequenceFlow id="F_Case6A" sourceRef="Send_AuthRequest" targetRef="GW_CaseJoin" />
    <bpmn:sequenceFlow id="F_Case6B" sourceRef="Send_CasePreparation" targetRef="GW_CaseJoin" />
    <bpmn:sequenceFlow id="F_Case7" sourceRef="GW_CaseJoin" targetRef="GW_CaseOutcome" />
    <bpmn:sequenceFlow id="F_Case8D" sourceRef="GW_CaseOutcome" targetRef="Catch_CaseDenial" />
    <bpmn:sequenceFlow id="F_Case8E" sourceRef="GW_CaseOutcome" targetRef="Catch_EvidenceReady" />
    <bpmn:sequenceFlow id="F_Case9D" sourceRef="Catch_CaseDenial" targetRef="State_CaseClosed" />
    <bpmn:sequenceFlow id="F_Case9E" sourceRef="Catch_EvidenceReady" targetRef="Task_RecordEvidenceReady" />
    <bpmn:sequenceFlow id="F_Case10" sourceRef="Task_RecordEvidenceReady" targetRef="Catch_Reconstruction" />
    <bpmn:sequenceFlow id="F_Case11" sourceRef="Catch_Reconstruction" targetRef="State_CaseClosed" />
    <bpmn:sequenceFlow id="F_Case12" sourceRef="State_CaseClosed" targetRef="End_Case" />
  </bpmn:process>
  <bpmn:process id="Process_Authorization" isExecutable="false">
    <bpmn:startEvent id="Start_Authorization" name="Authorization submitted">
      <bpmn:messageEventDefinition messageRef="Msg_AuthRequest" />
    </bpmn:startEvent>
    <bpmn:task id="State_AuthSubmitted" name="[STATE] submitted" />
    <bpmn:businessRuleTask id="Task_VerifyAuthorization" name="Verify issuer, signature, case, scope and completeness" />
    <bpmn:exclusiveGateway id="GW_AuthVerified" name="Authorization verifiable?" default="F_Auth4Denied" />
    <bpmn:task id="State_AuthVerified" name="[STATE] verified" />
    <bpmn:task id="Task_ActivateAuthorization" name="Activate within validity interval" />
    <bpmn:task id="State_AuthActive" name="[STATE] active" />
    <bpmn:task id="State_AuthDenied" name="[STATE] denied - terminal for this version" />
    <bpmn:sendTask id="Send_AuthDecision" name="Send active or denied decision" messageRef="Msg_AuthDecision" />
    <bpmn:exclusiveGateway id="GW_AuthDecisionSent" name="Decision status?" default="F_Auth8Denied" />
    <bpmn:eventBasedGateway id="GW_AuthTerminal" name="Wait for expiry or revocation" />
    <bpmn:intermediateCatchEvent id="Catch_AuthExpiry" name="Validity interval ends">
      <bpmn:timerEventDefinition>
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">authorization.valid_to</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_AuthRevocation" name="Issuer revokes authorization">
      <bpmn:signalEventDefinition signalRef="Signal_RevokeAuthorization" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="State_AuthExpired" name="[STATE] expired - terminal for this version" />
    <bpmn:task id="State_AuthRevoked" name="[STATE] revoked - terminal for this version" />
    <bpmn:sendTask id="Send_AuthTerminal" name="Notify acquisition of terminal status" messageRef="Msg_AuthTerminal" />
    <bpmn:endEvent id="End_Authorization" name="Authorization version terminal" />
    <bpmn:sequenceFlow id="F_Auth1" sourceRef="Start_Authorization" targetRef="State_AuthSubmitted" />
    <bpmn:sequenceFlow id="F_Auth2" sourceRef="State_AuthSubmitted" targetRef="Task_VerifyAuthorization" />
    <bpmn:sequenceFlow id="F_Auth3" sourceRef="Task_VerifyAuthorization" targetRef="GW_AuthVerified" />
    <bpmn:sequenceFlow id="F_Auth4Verified" name="valid" sourceRef="GW_AuthVerified" targetRef="State_AuthVerified">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">verify=valid and required_fields_complete</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Auth4Denied" name="invalid/default" sourceRef="GW_AuthVerified" targetRef="State_AuthDenied" />
    <bpmn:sequenceFlow id="F_Auth5" sourceRef="State_AuthVerified" targetRef="Task_ActivateAuthorization" />
    <bpmn:sequenceFlow id="F_Auth6" sourceRef="Task_ActivateAuthorization" targetRef="State_AuthActive" />
    <bpmn:sequenceFlow id="F_Auth7A" sourceRef="State_AuthActive" targetRef="Send_AuthDecision" />
    <bpmn:sequenceFlow id="F_Auth7D" sourceRef="State_AuthDenied" targetRef="Send_AuthDecision" />
    <bpmn:sequenceFlow id="F_Auth7Decision" sourceRef="Send_AuthDecision" targetRef="GW_AuthDecisionSent" />
    <bpmn:sequenceFlow id="F_Auth8Active" name="active decision" sourceRef="GW_AuthDecisionSent" targetRef="GW_AuthTerminal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">status=active</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Auth8Denied" name="denied/default" sourceRef="GW_AuthDecisionSent" targetRef="End_Authorization" />
    <bpmn:sequenceFlow id="F_Auth9E" sourceRef="GW_AuthTerminal" targetRef="Catch_AuthExpiry" />
    <bpmn:sequenceFlow id="F_Auth9R" sourceRef="GW_AuthTerminal" targetRef="Catch_AuthRevocation" />
    <bpmn:sequenceFlow id="F_Auth10E" sourceRef="Catch_AuthExpiry" targetRef="State_AuthExpired" />
    <bpmn:sequenceFlow id="F_Auth10R" sourceRef="Catch_AuthRevocation" targetRef="State_AuthRevoked" />
    <bpmn:sequenceFlow id="F_Auth11E" sourceRef="State_AuthExpired" targetRef="Send_AuthTerminal" />
    <bpmn:sequenceFlow id="F_Auth11R" sourceRef="State_AuthRevoked" targetRef="Send_AuthTerminal" />
    <bpmn:sequenceFlow id="F_Auth12" sourceRef="Send_AuthTerminal" targetRef="End_Authorization" />
  </bpmn:process>
  <bpmn:process id="Process_Acquisition" isExecutable="false">
    <bpmn:startEvent id="Start_Acquisition" name="Case request registered">
      <bpmn:messageEventDefinition messageRef="Msg_CasePreparation" />
    </bpmn:startEvent>
    <bpmn:task id="State_AcqRequestReceived" name="[STATE] request_received - no collection" />
    <bpmn:intermediateCatchEvent id="Catch_AuthDecision" name="Authorization decision received">
      <bpmn:messageEventDefinition messageRef="Msg_AuthDecision" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="GW_AcqAuthorized" name="Active authorization and ScopeOK?" default="F_Acq4Denied" />
    <bpmn:task id="State_AcqAuthorized" name="[STATE] authorized" />
    <bpmn:exclusiveGateway id="GW_AcqStart" name="Sources available and authorization still active?" default="F_Acq6Failed" />
    <bpmn:task id="State_AcqCollecting" name="[STATE] collecting - minimized eligible records only" />
    <bpmn:task id="State_AcqDenied" name="[STATE] denied - zero payload" />
    <bpmn:task id="State_AcqFailed" name="[STATE] failed - zero uncommitted payload" />
    <bpmn:eventBasedGateway id="GW_AcqTerminal" name="Wait for completion, authorization end, or failure" />
    <bpmn:intermediateCatchEvent id="Catch_AcqComplete" name="Eligible source reads complete">
      <bpmn:conditionalEventDefinition>
        <bpmn:condition xsi:type="bpmn:tFormalExpression">source_reads_complete=true</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_AuthTerminal" name="Authorization expired or revoked">
      <bpmn:messageEventDefinition messageRef="Msg_AuthTerminal" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_AcqFailure" name="Source/audit failure">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="GW_AuthTerminalKind" name="Expired or revoked?" default="F_Acq11Revoked" />
    <bpmn:task id="State_AcqCompleted" name="[STATE] completed" />
    <bpmn:task id="State_AcqExpired" name="[STATE] expired - collection stopped" />
    <bpmn:task id="State_AcqRevoked" name="[STATE] revoked - collection stopped" />
    <bpmn:sendTask id="Send_Candidates" name="Send authorized evidence candidates" messageRef="Msg_Candidates" />
    <bpmn:sendTask id="Send_Denial" name="Send denial/failure metadata only" messageRef="Msg_Denial" />
    <bpmn:endEvent id="End_Acquisition" name="Acquisition lifecycle terminal" />
    <bpmn:sequenceFlow id="F_Acq1" sourceRef="Start_Acquisition" targetRef="State_AcqRequestReceived" />
    <bpmn:sequenceFlow id="F_Acq2" sourceRef="State_AcqRequestReceived" targetRef="Catch_AuthDecision" />
    <bpmn:sequenceFlow id="F_Acq3" sourceRef="Catch_AuthDecision" targetRef="GW_AcqAuthorized" />
    <bpmn:sequenceFlow id="F_Acq4Authorized" name="active and in scope" sourceRef="GW_AcqAuthorized" targetRef="State_AcqAuthorized">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">authorization.status=active and ScopeOK(request,authorization)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Acq4Denied" name="deny/default" sourceRef="GW_AcqAuthorized" targetRef="State_AcqDenied" />
    <bpmn:sequenceFlow id="F_Acq5" sourceRef="State_AcqAuthorized" targetRef="GW_AcqStart" />
    <bpmn:sequenceFlow id="F_Acq6Collect" name="ready" sourceRef="GW_AcqStart" targetRef="State_AcqCollecting">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">sources_available and authorization.status=active</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Acq6Failed" name="unavailable/default" sourceRef="GW_AcqStart" targetRef="State_AcqFailed" />
    <bpmn:sequenceFlow id="F_Acq7" sourceRef="State_AcqCollecting" targetRef="GW_AcqTerminal" />
    <bpmn:sequenceFlow id="F_Acq8C" sourceRef="GW_AcqTerminal" targetRef="Catch_AcqComplete" />
    <bpmn:sequenceFlow id="F_Acq8A" sourceRef="GW_AcqTerminal" targetRef="Catch_AuthTerminal" />
    <bpmn:sequenceFlow id="F_Acq8F" sourceRef="GW_AcqTerminal" targetRef="Catch_AcqFailure" />
    <bpmn:sequenceFlow id="F_Acq9C" sourceRef="Catch_AcqComplete" targetRef="State_AcqCompleted" />
    <bpmn:sequenceFlow id="F_Acq9A" sourceRef="Catch_AuthTerminal" targetRef="GW_AuthTerminalKind" />
    <bpmn:sequenceFlow id="F_Acq9F" sourceRef="Catch_AcqFailure" targetRef="State_AcqFailed" />
    <bpmn:sequenceFlow id="F_Acq10Expired" name="expired" sourceRef="GW_AuthTerminalKind" targetRef="State_AcqExpired">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">authorization.status=expired</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Acq11Revoked" name="revoked/default" sourceRef="GW_AuthTerminalKind" targetRef="State_AcqRevoked" />
    <bpmn:sequenceFlow id="F_Acq12C" sourceRef="State_AcqCompleted" targetRef="Send_Candidates" />
    <bpmn:sequenceFlow id="F_Acq12D" sourceRef="State_AcqDenied" targetRef="Send_Denial" />
    <bpmn:sequenceFlow id="F_Acq12F" sourceRef="State_AcqFailed" targetRef="Send_Denial" />
    <bpmn:sequenceFlow id="F_Acq12E" sourceRef="State_AcqExpired" targetRef="Send_Denial" />
    <bpmn:sequenceFlow id="F_Acq12R" sourceRef="State_AcqRevoked" targetRef="Send_Denial" />
    <bpmn:sequenceFlow id="F_Acq13C" sourceRef="Send_Candidates" targetRef="End_Acquisition" />
    <bpmn:sequenceFlow id="F_Acq13D" sourceRef="Send_Denial" targetRef="End_Acquisition" />
  </bpmn:process>
  <bpmn:process id="Process_Door" isExecutable="false">
    <bpmn:startEvent id="Start_Door" name="Sensor initialized" />
    <bpmn:task id="State_DoorClosed" name="[STATE] closed_online; vD=0" />
    <bpmn:eventBasedGateway id="GW_DoorClosed" name="Wait while closed/online" />
    <bpmn:intermediateCatchEvent id="Catch_DoorOpen" name="door.open - physical entry">
      <bpmn:conditionalEventDefinition>
        <bpmn:condition xsi:type="bpmn:tFormalExpression">physical_contact=open</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_DoorTamperClosed" name="device.tamper; gammaD=1">
      <bpmn:signalEventDefinition signalRef="Signal_DeviceTamper" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_DoorDisconnectClosed" name="device.disconnect">
      <bpmn:signalEventDefinition signalRef="Signal_DeviceDisconnect" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="State_DoorOpen" name="[STATE] open_online; increment vD" />
    <bpmn:eventBasedGateway id="GW_DoorOpen" name="Wait while open/online" />
    <bpmn:intermediateCatchEvent id="Catch_DoorClose" name="door.close - physical close">
      <bpmn:conditionalEventDefinition>
        <bpmn:condition xsi:type="bpmn:tFormalExpression">physical_contact=closed</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_DoorTamperOpen" name="device.tamper; gammaD=1">
      <bpmn:signalEventDefinition signalRef="Signal_DeviceTamper" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_DoorDisconnectOpen" name="device.disconnect">
      <bpmn:signalEventDefinition signalRef="Signal_DeviceDisconnect" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="State_DoorTampered" name="[STATE] tampered; increment vD" />
    <bpmn:task id="State_DoorOffline" name="[STATE] offline; preserve last logical state; increment vD" />
    <bpmn:eventBasedGateway id="GW_DoorOffline" name="Wait for authorized restoration or scenario horizon" />
    <bpmn:intermediateCatchEvent id="Catch_DoorDisconnectTampered" name="device.disconnect">
      <bpmn:signalEventDefinition signalRef="Signal_DeviceDisconnect" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_DoorRestore" name="device.restore - authorized maintenance">
      <bpmn:conditionalEventDefinition>
        <bpmn:condition xsi:type="bpmn:tFormalExpression">maintenance.authorized=true</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_DoorHorizon" name="Simulation horizon reached">
      <bpmn:timerEventDefinition>
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">simulation.horizon</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="GW_DoorRecovered" name="Configured recovered logical state?" default="F_Door14Closed" />
    <bpmn:endEvent id="End_Door" name="Scenario ends with current state retained" />
    <bpmn:sequenceFlow id="F_Door1" sourceRef="Start_Door" targetRef="State_DoorClosed" />
    <bpmn:sequenceFlow id="F_Door2" sourceRef="State_DoorClosed" targetRef="GW_DoorClosed" />
    <bpmn:sequenceFlow id="F_Door3O" sourceRef="GW_DoorClosed" targetRef="Catch_DoorOpen" />
    <bpmn:sequenceFlow id="F_Door3T" sourceRef="GW_DoorClosed" targetRef="Catch_DoorTamperClosed" />
    <bpmn:sequenceFlow id="F_Door3D" sourceRef="GW_DoorClosed" targetRef="Catch_DoorDisconnectClosed" />
    <bpmn:sequenceFlow id="F_Door4O" sourceRef="Catch_DoorOpen" targetRef="State_DoorOpen" />
    <bpmn:sequenceFlow id="F_Door4T" sourceRef="Catch_DoorTamperClosed" targetRef="State_DoorTampered" />
    <bpmn:sequenceFlow id="F_Door4D" sourceRef="Catch_DoorDisconnectClosed" targetRef="State_DoorOffline" />
    <bpmn:sequenceFlow id="F_Door5" sourceRef="State_DoorOpen" targetRef="GW_DoorOpen" />
    <bpmn:sequenceFlow id="F_Door6C" sourceRef="GW_DoorOpen" targetRef="Catch_DoorClose" />
    <bpmn:sequenceFlow id="F_Door6T" sourceRef="GW_DoorOpen" targetRef="Catch_DoorTamperOpen" />
    <bpmn:sequenceFlow id="F_Door6D" sourceRef="GW_DoorOpen" targetRef="Catch_DoorDisconnectOpen" />
    <bpmn:sequenceFlow id="F_Door7C" sourceRef="Catch_DoorClose" targetRef="State_DoorClosed" />
    <bpmn:sequenceFlow id="F_Door7T" sourceRef="Catch_DoorTamperOpen" targetRef="State_DoorTampered" />
    <bpmn:sequenceFlow id="F_Door7D" sourceRef="Catch_DoorDisconnectOpen" targetRef="State_DoorOffline" />
    <bpmn:sequenceFlow id="F_Door8" sourceRef="State_DoorTampered" targetRef="Catch_DoorDisconnectTampered" />
    <bpmn:sequenceFlow id="F_Door9" sourceRef="Catch_DoorDisconnectTampered" targetRef="State_DoorOffline" />
    <bpmn:sequenceFlow id="F_Door10" sourceRef="State_DoorOffline" targetRef="GW_DoorOffline" />
    <bpmn:sequenceFlow id="F_Door10Restore" sourceRef="GW_DoorOffline" targetRef="Catch_DoorRestore" />
    <bpmn:sequenceFlow id="F_Door10Horizon" sourceRef="GW_DoorOffline" targetRef="Catch_DoorHorizon" />
    <bpmn:sequenceFlow id="F_Door11" sourceRef="Catch_DoorRestore" targetRef="GW_DoorRecovered" />
    <bpmn:sequenceFlow id="F_Door12Open" name="configured open" sourceRef="GW_DoorRecovered" targetRef="State_DoorOpen">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">recovered_logical_state=open</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Door14Closed" name="closed/default" sourceRef="GW_DoorRecovered" targetRef="State_DoorClosed" />
    <bpmn:sequenceFlow id="F_DoorEnd" sourceRef="Catch_DoorHorizon" targetRef="End_Door" />
  </bpmn:process>
  <bpmn:process id="Process_HA" isExecutable="false">
    <bpmn:startEvent id="Start_HA_Lifecycle" name="Home Assistant initialized" />
    <bpmn:task id="State_HAOnline" name="[STATE] online - ingest and automate" />
    <bpmn:eventBasedGateway id="GW_HAOnline" name="Wait for health transition" />
    <bpmn:intermediateCatchEvent id="Catch_HADegrade" name="Error/overload threshold crossed">
      <bpmn:conditionalEventDefinition>
        <bpmn:condition xsi:type="bpmn:tFormalExpression">health=degraded</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_HAOutage" name="Host/service unavailable">
      <bpmn:conditionalEventDefinition>
        <bpmn:condition xsi:type="bpmn:tFormalExpression">health=offline</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="State_HADegraded" name="[STATE] degraded - retain quality flags" />
    <bpmn:eventBasedGateway id="GW_HADegraded" name="Wait for recovery or failure" />
    <bpmn:intermediateCatchEvent id="Catch_HARecover" name="Health checks pass">
      <bpmn:conditionalEventDefinition>
        <bpmn:condition xsi:type="bpmn:tFormalExpression">health=online</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_HAFail" name="Service fails">
      <bpmn:conditionalEventDefinition>
        <bpmn:condition xsi:type="bpmn:tFormalExpression">health=offline</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="State_HAOffline" name="[STATE] offline - reject ingestion; emit no ordinary events" />
    <bpmn:eventBasedGateway id="GW_HAOffline" name="Wait for restoration or scenario horizon" />
    <bpmn:intermediateCatchEvent id="Catch_HARestore" name="Authorized service restoration">
      <bpmn:conditionalEventDefinition>
        <bpmn:condition xsi:type="bpmn:tFormalExpression">service_restored=true</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_HAHorizon" name="Simulation horizon reached">
      <bpmn:timerEventDefinition>
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">simulation.horizon</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_HA_Lifecycle" name="Scenario horizon; state retained" />
    <bpmn:sequenceFlow id="F_HA1" sourceRef="Start_HA_Lifecycle" targetRef="State_HAOnline" />
    <bpmn:sequenceFlow id="F_HA2" sourceRef="State_HAOnline" targetRef="GW_HAOnline" />
    <bpmn:sequenceFlow id="F_HA3D" sourceRef="GW_HAOnline" targetRef="Catch_HADegrade" />
    <bpmn:sequenceFlow id="F_HA3O" sourceRef="GW_HAOnline" targetRef="Catch_HAOutage" />
    <bpmn:sequenceFlow id="F_HA4D" sourceRef="Catch_HADegrade" targetRef="State_HADegraded" />
    <bpmn:sequenceFlow id="F_HA4O" sourceRef="Catch_HAOutage" targetRef="State_HAOffline" />
    <bpmn:sequenceFlow id="F_HA5" sourceRef="State_HADegraded" targetRef="GW_HADegraded" />
    <bpmn:sequenceFlow id="F_HA6R" sourceRef="GW_HADegraded" targetRef="Catch_HARecover" />
    <bpmn:sequenceFlow id="F_HA6F" sourceRef="GW_HADegraded" targetRef="Catch_HAFail" />
    <bpmn:sequenceFlow id="F_HA7R" sourceRef="Catch_HARecover" targetRef="State_HAOnline" />
    <bpmn:sequenceFlow id="F_HA7F" sourceRef="Catch_HAFail" targetRef="State_HAOffline" />
    <bpmn:sequenceFlow id="F_HA8" sourceRef="State_HAOffline" targetRef="GW_HAOffline" />
    <bpmn:sequenceFlow id="F_HA8Restore" sourceRef="GW_HAOffline" targetRef="Catch_HARestore" />
    <bpmn:sequenceFlow id="F_HA8Horizon" sourceRef="GW_HAOffline" targetRef="Catch_HAHorizon" />
    <bpmn:sequenceFlow id="F_HA9" sourceRef="Catch_HARestore" targetRef="State_HAOnline" />
    <bpmn:sequenceFlow id="F_HAEnd" sourceRef="Catch_HAHorizon" targetRef="End_HA_Lifecycle" />
  </bpmn:process>
  <bpmn:process id="Process_Evidence" isExecutable="false">
    <bpmn:startEvent id="Start_Evidence" name="Authorized candidate received">
      <bpmn:messageEventDefinition messageRef="Msg_Candidates" />
    </bpmn:startEvent>
    <bpmn:task id="State_EvidenceCollected" name="[STATE] collected - source/provenance fixed" />
    <bpmn:serviceTask id="Task_RegisterEvidence" name="Canonicalize, hash, store and append custody" />
    <bpmn:task id="State_EvidenceRegistered" name="[STATE] registered" />
    <bpmn:serviceTask id="Task_VerifyEvidence" name="Recompute content hash and custody chain" />
    <bpmn:exclusiveGateway id="GW_EvidenceVerified" name="Content and custody valid?" default="F_Evidence6Failed" />
    <bpmn:task id="State_EvidenceVerified" name="[STATE] verified" />
    <bpmn:task id="State_EvidenceFailed" name="[STATE] verification_failed - quarantined" />
    <bpmn:sendTask id="Send_EvidenceReady" name="Send verified manifest" messageRef="Msg_EvidenceReady" />
    <bpmn:intermediateCatchEvent id="Catch_EvidenceDispose" name="Retention expiry or authorized disposal">
      <bpmn:timerEventDefinition>
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">evidence.retention_end</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="State_EvidenceDisposed" name="[STATE] disposed - disposal custody action retained" />
    <bpmn:endEvent id="End_Evidence" name="Evidence lifecycle complete" />
    <bpmn:endEvent id="End_EvidenceFailed" name="Quarantined item retained" />
    <bpmn:sequenceFlow id="F_Evidence1" sourceRef="Start_Evidence" targetRef="State_EvidenceCollected" />
    <bpmn:sequenceFlow id="F_Evidence2" sourceRef="State_EvidenceCollected" targetRef="Task_RegisterEvidence" />
    <bpmn:sequenceFlow id="F_Evidence3" sourceRef="Task_RegisterEvidence" targetRef="State_EvidenceRegistered" />
    <bpmn:sequenceFlow id="F_Evidence4" sourceRef="State_EvidenceRegistered" targetRef="Task_VerifyEvidence" />
    <bpmn:sequenceFlow id="F_Evidence5" sourceRef="Task_VerifyEvidence" targetRef="GW_EvidenceVerified" />
    <bpmn:sequenceFlow id="F_Evidence6Verified" name="valid" sourceRef="GW_EvidenceVerified" targetRef="State_EvidenceVerified">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">content_hash_valid and CustodyValid(chain)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Evidence6Failed" name="invalid/default" sourceRef="GW_EvidenceVerified" targetRef="State_EvidenceFailed" />
    <bpmn:sequenceFlow id="F_Evidence7" sourceRef="State_EvidenceVerified" targetRef="Send_EvidenceReady" />
    <bpmn:sequenceFlow id="F_Evidence8" sourceRef="Send_EvidenceReady" targetRef="Catch_EvidenceDispose" />
    <bpmn:sequenceFlow id="F_Evidence9" sourceRef="Catch_EvidenceDispose" targetRef="State_EvidenceDisposed" />
    <bpmn:sequenceFlow id="F_Evidence10" sourceRef="State_EvidenceDisposed" targetRef="End_Evidence" />
    <bpmn:sequenceFlow id="F_Evidence11" sourceRef="State_EvidenceFailed" targetRef="End_EvidenceFailed" />
  </bpmn:process>
