<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_UC4_Evidence" targetNamespace="https://salus-project.eu/t43/uc4/evidence">
  <bpmn:message id="Msg_Candidates" name="Authorized evidence candidates"/><bpmn:message id="Msg_VerifiedEvidence" name="Verified evidence manifest"/><bpmn:message id="Msg_Reconstruction" name="Qualified reconstruction report"/>
  <bpmn:error id="Error_Storage" name="Evidence storage failure" errorCode="UC4-EVIDENCE-STORAGE"/><bpmn:dataStore id="Store_Evidence" name="Content-addressed evidence repository (UC4-S03)"/><bpmn:dataStore id="Store_Custody" name="Append-only custody ledger (UC4-S04)"/><bpmn:dataStore id="Store_Audit" name="Investigation audit"/>
  <bpmn:collaboration id="Collab_UC4_Evidence">
    <bpmn:participant id="Participant_Acquisition" name="Lawful acquisition output (UC4-S02)" processRef="Process_AcquisitionOutput"/><bpmn:participant id="Participant_Preservation" name="Evidence repository and custody adapter (UC4-S03/S04)" processRef="Process_Preservation"/><bpmn:participant id="Participant_Reconstruction" name="Reconstruction service (UC4-S05)" processRef="Process_Reconstruction"/><bpmn:participant id="Participant_Review" name="Investigator and auditor (UC4-A02/A06)" processRef="Process_Review"/>
    <bpmn:messageFlow id="MF_Candidates" sourceRef="Send_Candidates" targetRef="Start_Preservation"/><bpmn:messageFlow id="MF_VerifiedEvidence" sourceRef="Send_VerifiedEvidence" targetRef="Start_Reconstruction"/><bpmn:messageFlow id="MF_Reconstruction" sourceRef="Send_Reconstruction" targetRef="Start_Review"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_AcquisitionOutput" isExecutable="false"><bpmn:startEvent id="Start_CandidateOutput" name="Allowed acquisition complete"/><bpmn:task id="Task_BindDecision" name="Bind source bytes to authorization and policy-decision IDs"/><bpmn:sendTask id="Send_Candidates" name="Transfer authorized candidates" messageRef="Msg_Candidates"/><bpmn:endEvent id="End_CandidateOutput" name="Transfer initiated"/><bpmn:sequenceFlow id="F_A1" sourceRef="Start_CandidateOutput" targetRef="Task_BindDecision"/><bpmn:sequenceFlow id="F_A2" sourceRef="Task_BindDecision" targetRef="Send_Candidates"/><bpmn:sequenceFlow id="F_A3" sourceRef="Send_Candidates" targetRef="End_CandidateOutput"/></bpmn:process>
  <bpmn:process id="Process_Preservation" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Preservation"><bpmn:lane id="Lane_Repository" name="Evidence repository"><bpmn:flowNodeRef>Start_Preservation</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ValidateCandidate</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Canonicalize</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_HashStore</bpmn:flowNodeRef><bpmn:flowNodeRef>Boundary_StorageFailure</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_QuarantineStorage</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Custody" name="Custody ledger adapter"><bpmn:flowNodeRef>Task_AppendCustody</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_VerifyIntegrity</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Integrity</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_QuarantineIntegrity</bpmn:flowNodeRef><bpmn:flowNodeRef>Send_VerifiedEvidence</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Preserved</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Quarantined</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
    <bpmn:dataObject id="DataObject_EvidenceItem" name="Evidence item UC4-DO05"/><bpmn:dataObjectReference id="DOR_EvidenceItem" name="Immutable evidence item" dataObjectRef="DataObject_EvidenceItem"/>
    <bpmn:startEvent id="Start_Preservation" name="Candidates received"><bpmn:messageEventDefinition messageRef="Msg_Candidates"/></bpmn:startEvent><bpmn:task id="Task_ValidateCandidate" name="Validate schema, scope proof, provenance and source hash"/><bpmn:task id="Task_Canonicalize" name="Canonicalize metadata without altering source bytes"/><bpmn:serviceTask id="Task_HashStore" name="Compute SHA-256 and store content-addressed object"/><bpmn:boundaryEvent id="Boundary_StorageFailure" name="Storage failure" attachedToRef="Task_HashStore"><bpmn:errorEventDefinition errorRef="Error_Storage"/></bpmn:boundaryEvent><bpmn:task id="Task_AppendCustody" name="Append COLLECTED and STORED custody transitions"/><bpmn:task id="Task_VerifyIntegrity" name="Recompute hash and verify custody predecessor chain"/><bpmn:exclusiveGateway id="GW_Integrity" name="Hash and custody chain valid?" default="F_P7_Invalid"/><bpmn:sendTask id="Send_VerifiedEvidence" name="Send evidence IDs, hashes and verified manifest" messageRef="Msg_VerifiedEvidence"/><bpmn:task id="Task_QuarantineIntegrity" name="Quarantine item and append integrity-failure audit"/><bpmn:task id="Task_QuarantineStorage" name="Audit storage failure; expose no incomplete item"/><bpmn:endEvent id="End_Preserved" name="Evidence preserved and verified"/><bpmn:endEvent id="End_Quarantined" name="Candidate quarantined"/><bpmn:dataStoreReference id="DSR_Evidence" name="Evidence repository" dataStoreRef="Store_Evidence"/><bpmn:dataStoreReference id="DSR_Custody" name="Custody ledger" dataStoreRef="Store_Custody"/>
    <bpmn:sequenceFlow id="F_P1" sourceRef="Start_Preservation" targetRef="Task_ValidateCandidate"/><bpmn:sequenceFlow id="F_P2" sourceRef="Task_ValidateCandidate" targetRef="Task_Canonicalize"/><bpmn:sequenceFlow id="F_P3" sourceRef="Task_Canonicalize" targetRef="Task_HashStore"/><bpmn:sequenceFlow id="F_P4" sourceRef="Task_HashStore" targetRef="Task_AppendCustody"/><bpmn:sequenceFlow id="F_P5" sourceRef="Task_AppendCustody" targetRef="Task_VerifyIntegrity"/><bpmn:sequenceFlow id="F_P6" sourceRef="Task_VerifyIntegrity" targetRef="GW_Integrity"/><bpmn:sequenceFlow id="F_P7_Valid" name="valid" sourceRef="GW_Integrity" targetRef="Send_VerifiedEvidence"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">sha256(source_bytes)=evidence.content_hash and CustodyValid(chain)</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="F_P7_Invalid" name="invalid/default" sourceRef="GW_Integrity" targetRef="Task_QuarantineIntegrity"/><bpmn:sequenceFlow id="F_P8" sourceRef="Send_VerifiedEvidence" targetRef="End_Preserved"/><bpmn:sequenceFlow id="F_P9" sourceRef="Task_QuarantineIntegrity" targetRef="End_Quarantined"/><bpmn:sequenceFlow id="F_P10_Error" sourceRef="Boundary_StorageFailure" targetRef="Task_QuarantineStorage"/><bpmn:sequenceFlow id="F_P11" sourceRef="Task_QuarantineStorage" targetRef="End_Quarantined"/>
  </bpmn:process>
  <bpmn:process id="Process_Reconstruction" isExecutable="false">
    <bpmn:dataObject id="DataObject_Reconstruction" name="Reconstruction report UC4-DO09"/><bpmn:dataObjectReference id="DOR_Reconstruction" name="Qualified reconstruction" dataObjectRef="DataObject_Reconstruction"/>
    <bpmn:startEvent id="Start_Reconstruction" name="Verified manifest received"><bpmn:messageEventDefinition messageRef="Msg_VerifiedEvidence"/></bpmn:startEvent><bpmn:task id="Task_LoadEvidence" name="Load only manifest-listed verified evidence"/><bpmn:task id="Task_NormalizeClocks" name="Normalize clock domains and retain uncertainty intervals"/><bpmn:exclusiveGateway id="GW_OrderingCertain" name="Event ordering uniquely determined?" default="F_R4_Uncertain"/><bpmn:task id="Task_OrderCertain" name="Build deterministic partial order"/><bpmn:task id="Task_OrderUncertain" name="Represent alternative admissible orderings"/><bpmn:task id="Task_Correlate" name="Correlate device, HA and CPE records by entity/time/causal IDs"/><bpmn:businessRuleTask id="Task_ScoreClaims" name="Compute weighted support, contradiction and missingness"/><bpmn:task id="Task_Alternatives" name="Generate benign and incident alternative explanations"/><bpmn:exclusiveGateway id="GW_Support" name="Incident claim reaches support threshold?" default="F_R10_Inconclusive"/><bpmn:task id="Task_QualifiedFinding" name="Create qualified finding with assumptions and confidence"/><bpmn:task id="Task_Inconclusive" name="Create inconclusive finding and identify missing evidence"/><bpmn:sendTask id="Send_Reconstruction" name="Send reconstruction, alternatives and trace matrix" messageRef="Msg_Reconstruction"/><bpmn:endEvent id="End_Reconstruction" name="Reconstruction package complete"/>
    <bpmn:sequenceFlow id="F_R1" sourceRef="Start_Reconstruction" targetRef="Task_LoadEvidence"/><bpmn:sequenceFlow id="F_R2" sourceRef="Task_LoadEvidence" targetRef="Task_NormalizeClocks"/><bpmn:sequenceFlow id="F_R3" sourceRef="Task_NormalizeClocks" targetRef="GW_OrderingCertain"/><bpmn:sequenceFlow id="F_R4_Certain" name="non-overlapping intervals" sourceRef="GW_OrderingCertain" targetRef="Task_OrderCertain"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">for compared events: upper(t_i)&lt;lower(t_j)</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="F_R4_Uncertain" name="overlap/default" sourceRef="GW_OrderingCertain" targetRef="Task_OrderUncertain"/><bpmn:sequenceFlow id="F_R5" sourceRef="Task_OrderCertain" targetRef="Task_Correlate"/><bpmn:sequenceFlow id="F_R6" sourceRef="Task_OrderUncertain" targetRef="Task_Correlate"/><bpmn:sequenceFlow id="F_R7" sourceRef="Task_Correlate" targetRef="Task_ScoreClaims"/><bpmn:sequenceFlow id="F_R8" sourceRef="Task_ScoreClaims" targetRef="Task_Alternatives"/><bpmn:sequenceFlow id="F_R9" sourceRef="Task_Alternatives" targetRef="GW_Support"/><bpmn:sequenceFlow id="F_R10_Supported" name="supported" sourceRef="GW_Support" targetRef="Task_QualifiedFinding"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">claim_score &gt;= theta_claim and no fatal integrity defect</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="F_R10_Inconclusive" name="inconclusive/default" sourceRef="GW_Support" targetRef="Task_Inconclusive"/><bpmn:sequenceFlow id="F_R11" sourceRef="Task_QualifiedFinding" targetRef="Send_Reconstruction"/><bpmn:sequenceFlow id="F_R12" sourceRef="Task_Inconclusive" targetRef="Send_Reconstruction"/><bpmn:sequenceFlow id="F_R13" sourceRef="Send_Reconstruction" targetRef="End_Reconstruction"/>
  </bpmn:process>
  <bpmn:process id="Process_Review" isExecutable="false">
    <bpmn:startEvent id="Start_Review" name="Reconstruction received"><bpmn:messageEventDefinition messageRef="Msg_Reconstruction"/></bpmn:startEvent><bpmn:userTask id="Task_AuditReview" name="Review policy proof, hashes, custody chain, uncertainty and alternatives"/><bpmn:exclusiveGateway id="GW_PackageValid" name="Technical package internally valid?" default="F_V3_Invalid"/><bpmn:task id="Task_AcceptReport" name="Accept as technical investigation output; make no legal conclusion"/><bpmn:task id="Task_RejectReport" name="Reject/quarantine package and record defects"/><bpmn:endEvent id="End_Accepted" name="Audited investigation bundle complete"/><bpmn:endEvent id="End_Rejected" name="Package rejected"/><bpmn:dataStoreReference id="DSR_Audit" name="Investigation audit" dataStoreRef="Store_Audit"/>
    <bpmn:sequenceFlow id="F_V1" sourceRef="Start_Review" targetRef="Task_AuditReview"/><bpmn:sequenceFlow id="F_V2" sourceRef="Task_AuditReview" targetRef="GW_PackageValid"/><bpmn:sequenceFlow id="F_V3_Valid" name="valid" sourceRef="GW_PackageValid" targetRef="Task_AcceptReport"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">policy_proof_valid and hashes_valid and custody_valid and trace_complete</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="F_V3_Invalid" name="invalid/default" sourceRef="GW_PackageValid" targetRef="Task_RejectReport"/><bpmn:sequenceFlow id="F_V4" sourceRef="Task_AcceptReport" targetRef="End_Accepted"/><bpmn:sequenceFlow id="F_V5" sourceRef="Task_RejectReport" targetRef="End_Rejected"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Evidence"><bpmndi:BPMNPlane id="Plane_Evidence" bpmnElement="Collab_UC4_Evidence">
    <bpmndi:BPMNShape id="Sh_EvidenceObject" bpmnElement="DOR_EvidenceItem"><dc:Bounds x="1820" y="325" width="36" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_ReconstructionObject" bpmnElement="DOR_Reconstruction"><dc:Bounds x="2035" y="675" width="36" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sh_PA" bpmnElement="Participant_Acquisition" isHorizontal="true"><dc:Bounds x="30" y="20" width="2100" height="120"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_SA" bpmnElement="Start_CandidateOutput"><dc:Bounds x="80" y="62" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_Bind" bpmnElement="Task_BindDecision"><dc:Bounds x="160" y="40" width="190" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_SendCandidates" bpmnElement="Send_Candidates"><dc:Bounds x="400" y="40" width="170" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_EA" bpmnElement="End_CandidateOutput"><dc:Bounds x="620" y="62" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sh_PP" bpmnElement="Participant_Preservation" isHorizontal="true"><dc:Bounds x="30" y="160" width="2100" height="310"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_LRepo" bpmnElement="Lane_Repository" isHorizontal="true"><dc:Bounds x="60" y="160" width="2070" height="150"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_LCustody" bpmnElement="Lane_Custody" isHorizontal="true"><dc:Bounds x="60" y="310" width="2070" height="160"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_SP" bpmnElement="Start_Preservation"><dc:Bounds x="80" y="217" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_Validate" bpmnElement="Task_ValidateCandidate"><dc:Bounds x="150" y="195" width="170" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_Canon" bpmnElement="Task_Canonicalize"><dc:Bounds x="360" y="195" width="170" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_Hash" bpmnElement="Task_HashStore"><dc:Bounds x="570" y="195" width="180" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_BStorage" bpmnElement="Boundary_StorageFailure"><dc:Bounds x="642" y="257" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_QStorage" bpmnElement="Task_QuarantineStorage"><dc:Bounds x="720" y="255" width="170" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_Append" bpmnElement="Task_AppendCustody"><dc:Bounds x="800" y="340" width="180" height="75"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_Verify" bpmnElement="Task_VerifyIntegrity"><dc:Bounds x="1020" y="340" width="180" height="75"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_GWIntegrity" bpmnElement="GW_Integrity" isMarkerVisible="true"><dc:Bounds x="1240" y="352" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_SendVerified" bpmnElement="Send_VerifiedEvidence"><dc:Bounds x="1340" y="320" width="180" height="70"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_QIntegrity" bpmnElement="Task_QuarantineIntegrity"><dc:Bounds x="1340" y="400" width="180" height="60"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_EndPres" bpmnElement="End_Preserved"><dc:Bounds x="1570" y="337" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_EndQ" bpmnElement="End_Quarantined"><dc:Bounds x="1570" y="412" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_EvidenceStore" bpmnElement="DSR_Evidence"><dc:Bounds x="1660" y="325" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_CustodyStore" bpmnElement="DSR_Custody"><dc:Bounds x="1740" y="325" width="50" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sh_PR" bpmnElement="Participant_Reconstruction" isHorizontal="true"><dc:Bounds x="30" y="490" width="2100" height="260"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_SR" bpmnElement="Start_Reconstruction"><dc:Bounds x="80" y="602" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_Load" bpmnElement="Task_LoadEvidence"><dc:Bounds x="150" y="580" width="150" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_Clocks" bpmnElement="Task_NormalizeClocks"><dc:Bounds x="340" y="580" width="165" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_GWOrder" bpmnElement="GW_OrderingCertain" isMarkerVisible="true"><dc:Bounds x="545" y="595" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_Certain" bpmnElement="Task_OrderCertain"><dc:Bounds x="635" y="525" width="150" height="65"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_Uncertain" bpmnElement="Task_OrderUncertain"><dc:Bounds x="635" y="655" width="150" height="65"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_Correlate" bpmnElement="Task_Correlate"><dc:Bounds x="830" y="580" width="165" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_Score" bpmnElement="Task_ScoreClaims"><dc:Bounds x="1035" y="580" width="165" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_Alternatives" bpmnElement="Task_Alternatives"><dc:Bounds x="1240" y="580" width="165" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_GWSupport" bpmnElement="GW_Support" isMarkerVisible="true"><dc:Bounds x="1445" y="595" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_Qualified" bpmnElement="Task_QualifiedFinding"><dc:Bounds x="1540" y="525" width="170" height="65"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_Inconclusive" bpmnElement="Task_Inconclusive"><dc:Bounds x="1540" y="655" width="170" height="65"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_SendRecon" bpmnElement="Send_Reconstruction"><dc:Bounds x="1760" y="580" width="170" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_EndRecon" bpmnElement="End_Reconstruction"><dc:Bounds x="1980" y="602" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sh_PV" bpmnElement="Participant_Review" isHorizontal="true"><dc:Bounds x="30" y="770" width="2100" height="190"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_SV" bpmnElement="Start_Review"><dc:Bounds x="80" y="847" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_AuditReview" bpmnElement="Task_AuditReview"><dc:Bounds x="160" y="825" width="190" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_GWPackage" bpmnElement="GW_PackageValid" isMarkerVisible="true"><dc:Bounds x="400" y="840" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_AcceptReport" bpmnElement="Task_AcceptReport"><dc:Bounds x="500" y="790" width="190" height="65"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_RejectReport" bpmnElement="Task_RejectReport"><dc:Bounds x="500" y="880" width="190" height="65"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_EndAccepted" bpmnElement="End_Accepted"><dc:Bounds x="740" y="805" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_EndRejected" bpmnElement="End_Rejected"><dc:Bounds x="740" y="895" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_Audit" bpmnElement="DSR_Audit"><dc:Bounds x="830" y="825" width="50" height="50"/></bpmndi:BPMNShape>
