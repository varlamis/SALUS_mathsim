<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_UC4_Acquisition" targetNamespace="https://salus-project.eu/t43/uc4/acquisition">
  <bpmn:message id="Msg_AuthorizationRequest" name="Authorization request"/><bpmn:message id="Msg_Authorization" name="Signed authorization object (UC4-DO01)"/><bpmn:message id="Msg_AcquisitionRequest" name="Authenticated scoped acquisition request"/><bpmn:message id="Msg_SourceQuery" name="Minimally scoped source query"/><bpmn:message id="Msg_SourceRecords" name="Candidate source records"/><bpmn:message id="Msg_AcquisitionResult" name="Evidence candidates or denial metadata"/>
  <bpmn:error id="Error_SourceFailure" name="Source unavailable" errorCode="UC4-SOURCE-FAILURE"/><bpmn:dataStore id="Store_PolicyAudit" name="Append-only policy decision audit"/><bpmn:dataStore id="Store_Source" name="CPE/HA/device source artefacts"/>
  <bpmn:collaboration id="Collab_UC4_Acquisition">
    <bpmn:participant id="Participant_Investigator" name="Authorized investigator (UC4-A02)" processRef="Process_Investigator"/><bpmn:participant id="Participant_Authority" name="Authorizing authority (UC4-A03)" processRef="Process_Authority"/><bpmn:participant id="Participant_LI" name="Lawful-interception module (UC4-S02)" processRef="Process_LI"/><bpmn:participant id="Participant_Sources" name="CPE, Home Assistant and approved sources (UC4-D01/D02)" processRef="Process_Sources"/>
    <bpmn:messageFlow id="MF_AuthRequest" sourceRef="Send_AuthRequest" targetRef="Start_Authority"/><bpmn:messageFlow id="MF_Authorization" sourceRef="Send_Authorization" targetRef="Catch_Authorization"/><bpmn:messageFlow id="MF_AcqRequest" sourceRef="Send_AcqRequest" targetRef="Start_LI"/><bpmn:messageFlow id="MF_SourceQuery" sourceRef="Send_SourceQuery" targetRef="Start_SourceQuery"/><bpmn:messageFlow id="MF_SourceRecords" sourceRef="Send_SourceRecords" targetRef="Catch_SourceRecords"/><bpmn:messageFlow id="MF_Result" sourceRef="Send_Result" targetRef="Catch_Result"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Investigator" isExecutable="false">
    <bpmn:dataObject id="DataObject_AcquisitionRequest" name="Acquisition request"/><bpmn:dataObjectReference id="DOR_AcquisitionRequest" name="Bound scoped request" dataObjectRef="DataObject_AcquisitionRequest"/>
    <bpmn:startEvent id="Start_Investigator" name="Open case requires evidence"/><bpmn:task id="Task_DraftScope" name="Draft purpose, targets, data types, actions and time window"/><bpmn:sendTask id="Send_AuthRequest" name="Request independent authorization" messageRef="Msg_AuthorizationRequest"/><bpmn:intermediateCatchEvent id="Catch_Authorization" name="Receive signed authorization"><bpmn:messageEventDefinition messageRef="Msg_Authorization"/></bpmn:intermediateCatchEvent><bpmn:task id="Task_BindRequest" name="Bind session, case and authorization IDs"/><bpmn:sendTask id="Send_AcqRequest" name="Submit authenticated acquisition request" messageRef="Msg_AcquisitionRequest"/><bpmn:intermediateCatchEvent id="Catch_Result" name="Receive candidates or denial"><bpmn:messageEventDefinition messageRef="Msg_AcquisitionResult"/></bpmn:intermediateCatchEvent><bpmn:exclusiveGateway id="GW_ResultAllowed" name="Evidence candidates disclosed?" default="F_I8_Denied"/><bpmn:task id="Task_AcceptCandidates" name="Accept candidates for evidence-preservation process"/><bpmn:task id="Task_AcceptDenial" name="Record denial; no evidence payload"/><bpmn:endEvent id="End_Allowed" name="Candidates handed to preservation"/><bpmn:endEvent id="End_Denied" name="Request closed or revised"/>
    <bpmn:sequenceFlow id="F_I1" sourceRef="Start_Investigator" targetRef="Task_DraftScope"/><bpmn:sequenceFlow id="F_I2" sourceRef="Task_DraftScope" targetRef="Send_AuthRequest"/><bpmn:sequenceFlow id="F_I3" sourceRef="Send_AuthRequest" targetRef="Catch_Authorization"/><bpmn:sequenceFlow id="F_I4" sourceRef="Catch_Authorization" targetRef="Task_BindRequest"/><bpmn:sequenceFlow id="F_I5" sourceRef="Task_BindRequest" targetRef="Send_AcqRequest"/><bpmn:sequenceFlow id="F_I6" sourceRef="Send_AcqRequest" targetRef="Catch_Result"/><bpmn:sequenceFlow id="F_I7" sourceRef="Catch_Result" targetRef="GW_ResultAllowed"/><bpmn:sequenceFlow id="F_I8_Allowed" name="allowed" sourceRef="GW_ResultAllowed" targetRef="Task_AcceptCandidates"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">response.decision=ALLOW and payload.count&gt;0</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="F_I8_Denied" name="denied/default" sourceRef="GW_ResultAllowed" targetRef="Task_AcceptDenial"/><bpmn:sequenceFlow id="F_I9" sourceRef="Task_AcceptCandidates" targetRef="End_Allowed"/><bpmn:sequenceFlow id="F_I10" sourceRef="Task_AcceptDenial" targetRef="End_Denied"/>
  </bpmn:process>
  <bpmn:process id="Process_Authority" isExecutable="false">
    <bpmn:dataObject id="DataObject_Authorization" name="Authorization object UC4-DO01"/><bpmn:dataObjectReference id="DOR_Authorization" name="Signed authorization or refusal" dataObjectRef="DataObject_Authorization"/>
    <bpmn:startEvent id="Start_Authority" name="Authorization request received"><bpmn:messageEventDefinition messageRef="Msg_AuthorizationRequest"/></bpmn:startEvent><bpmn:userTask id="Task_ReviewLegalBasis" name="Review legal basis, necessity, proportionality and scope"/><bpmn:exclusiveGateway id="GW_IssueAuth" name="Issue authorization?" default="F_A3_No"/><bpmn:task id="Task_CreateAuthorization" name="Create signed, versioned authorization with validity interval"/><bpmn:task id="Task_CreateRefusal" name="Create signed refusal object with no collection permission"/><bpmn:sendTask id="Send_Authorization" name="Return authorization decision" messageRef="Msg_Authorization"/><bpmn:endEvent id="End_Authority" name="Decision issued"/>
    <bpmn:sequenceFlow id="F_A1" sourceRef="Start_Authority" targetRef="Task_ReviewLegalBasis"/><bpmn:sequenceFlow id="F_A2" sourceRef="Task_ReviewLegalBasis" targetRef="GW_IssueAuth"/><bpmn:sequenceFlow id="F_A3_Yes" name="approved" sourceRef="GW_IssueAuth" targetRef="Task_CreateAuthorization"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">authority.decision=APPROVE</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="F_A3_No" name="refused/default" sourceRef="GW_IssueAuth" targetRef="Task_CreateRefusal"/><bpmn:sequenceFlow id="F_A4" sourceRef="Task_CreateAuthorization" targetRef="Send_Authorization"/><bpmn:sequenceFlow id="F_A5" sourceRef="Task_CreateRefusal" targetRef="Send_Authorization"/><bpmn:sequenceFlow id="F_A6" sourceRef="Send_Authorization" targetRef="End_Authority"/>
  </bpmn:process>
  <bpmn:process id="Process_LI" isExecutable="false">
    <bpmn:laneSet id="LaneSet_LI"><bpmn:lane id="Lane_Policy" name="Authentication and policy decision"><bpmn:flowNodeRef>Start_LI</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Authenticate</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Authenticated</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_VerifyAuthorization</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_AuthValid</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CheckScope</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_InScope</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Deny</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Acquisition" name="Scoped acquisition and minimization"><bpmn:flowNodeRef>Send_SourceQuery</bpmn:flowNodeRef><bpmn:flowNodeRef>Catch_SourceRecords</bpmn:flowNodeRef><bpmn:flowNodeRef>Boundary_AuthExpiry</bpmn:flowNodeRef><bpmn:flowNodeRef>Boundary_SourceTimeout</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Minimize</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_NonEmpty</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_PackageCandidates</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Audit" name="Decision audit and response"><bpmn:flowNodeRef>Task_StopExpired</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_SourceFailure</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RecordDecision</bpmn:flowNodeRef><bpmn:flowNodeRef>Send_Result</bpmn:flowNodeRef><bpmn:flowNodeRef>End_LI</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
    <bpmn:dataObject id="DataObject_PolicyDecision" name="Policy decision UC4-DO07"/><bpmn:dataObjectReference id="DOR_PolicyDecision" name="Allow/deny decision" dataObjectRef="DataObject_PolicyDecision"/>
    <bpmn:startEvent id="Start_LI" name="Acquisition request received"><bpmn:messageEventDefinition messageRef="Msg_AcquisitionRequest"/></bpmn:startEvent><bpmn:serviceTask id="Task_Authenticate" name="Authenticate session and requester role"/><bpmn:exclusiveGateway id="GW_Authenticated" name="Authenticated as authorized investigator?" default="F_L3_No"/><bpmn:businessRuleTask id="Task_VerifyAuthorization" name="Verify signature, status, case binding and validity interval"/><bpmn:exclusiveGateway id="GW_AuthValid" name="Authorization active and valid now?" default="F_L6_No"/><bpmn:businessRuleTask id="Task_CheckScope" name="Check subject, entity, data type, action, purpose and evidence window"/><bpmn:exclusiveGateway id="GW_InScope" name="Entire request within authorization scope?" default="F_L9_No"/><bpmn:sendTask id="Send_SourceQuery" name="Issue least-privilege source query" messageRef="Msg_SourceQuery"/><bpmn:receiveTask id="Catch_SourceRecords" name="Receive candidate records" messageRef="Msg_SourceRecords" instantiate="false"/><bpmn:boundaryEvent id="Boundary_AuthExpiry" name="Authorization expires/revoked" attachedToRef="Catch_SourceRecords" cancelActivity="true"><bpmn:timerEventDefinition><bpmn:timeDate xsi:type="bpmn:tFormalExpression">authorization.valid_to</bpmn:timeDate></bpmn:timerEventDefinition></bpmn:boundaryEvent><bpmn:boundaryEvent id="Boundary_SourceTimeout" name="Source timeout" attachedToRef="Catch_SourceRecords" cancelActivity="true"><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5S</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent><bpmn:task id="Task_Minimize" name="Filter fields and records to authorized projection"/><bpmn:exclusiveGateway id="GW_NonEmpty" name="Authorized projection non-empty?" default="F_L13_Empty"/><bpmn:task id="Task_PackageCandidates" name="Package source bytes, provenance and decision reference"/><bpmn:task id="Task_Deny" name="Create deny decision; suppress evidence payload"/><bpmn:task id="Task_StopExpired" name="Stop collection and discard uncommitted records"/><bpmn:task id="Task_SourceFailure" name="Record source-timeout denial"/><bpmn:task id="Task_RecordDecision" name="Append policy decision and reason codes"/><bpmn:sendTask id="Send_Result" name="Return candidates or denial metadata" messageRef="Msg_AcquisitionResult"/><bpmn:endEvent id="End_LI" name="Acquisition transaction closed"/><bpmn:dataStoreReference id="DSR_PolicyAudit" name="Policy audit" dataStoreRef="Store_PolicyAudit"/>
    <bpmn:sequenceFlow id="F_L1" sourceRef="Start_LI" targetRef="Task_Authenticate"/><bpmn:sequenceFlow id="F_L2" sourceRef="Task_Authenticate" targetRef="GW_Authenticated"/><bpmn:sequenceFlow id="F_L3_Yes" name="yes" sourceRef="GW_Authenticated" targetRef="Task_VerifyAuthorization"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">session.authenticated and role=INVESTIGATOR</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="F_L3_No" name="no/default" sourceRef="GW_Authenticated" targetRef="Task_Deny"/><bpmn:sequenceFlow id="F_L4" sourceRef="Task_VerifyAuthorization" targetRef="GW_AuthValid"/><bpmn:sequenceFlow id="F_L5_Yes" name="valid" sourceRef="GW_AuthValid" targetRef="Task_CheckScope"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">signature_valid and status=ACTIVE and valid_from&lt;=now&lt;valid_to and case_bound</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="F_L6_No" name="invalid/default" sourceRef="GW_AuthValid" targetRef="Task_Deny"/><bpmn:sequenceFlow id="F_L7" sourceRef="Task_CheckScope" targetRef="GW_InScope"/><bpmn:sequenceFlow id="F_L8_Yes" name="all dimensions in scope" sourceRef="GW_InScope" targetRef="Send_SourceQuery"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">ScopeOK(request, authorization)=true</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="F_L9_No" name="out of scope/default" sourceRef="GW_InScope" targetRef="Task_Deny"/><bpmn:sequenceFlow id="F_L10" sourceRef="Send_SourceQuery" targetRef="Catch_SourceRecords"/><bpmn:sequenceFlow id="F_L11" sourceRef="Catch_SourceRecords" targetRef="Task_Minimize"/><bpmn:sequenceFlow id="F_L12" sourceRef="Task_Minimize" targetRef="GW_NonEmpty"/><bpmn:sequenceFlow id="F_L13_NonEmpty" name="non-empty" sourceRef="GW_NonEmpty" targetRef="Task_PackageCandidates"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">count(project(records, authorized_fields)) &gt; 0</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="F_L13_Empty" name="empty/default" sourceRef="GW_NonEmpty" targetRef="Task_Deny"/><bpmn:sequenceFlow id="F_L14" sourceRef="Task_PackageCandidates" targetRef="Task_RecordDecision"/><bpmn:sequenceFlow id="F_L15" sourceRef="Task_Deny" targetRef="Task_RecordDecision"/><bpmn:sequenceFlow id="F_L16_Expiry" sourceRef="Boundary_AuthExpiry" targetRef="Task_StopExpired"/><bpmn:sequenceFlow id="F_L17" sourceRef="Task_StopExpired" targetRef="Task_RecordDecision"/><bpmn:sequenceFlow id="F_L18_Timeout" sourceRef="Boundary_SourceTimeout" targetRef="Task_SourceFailure"/><bpmn:sequenceFlow id="F_L19" sourceRef="Task_SourceFailure" targetRef="Task_RecordDecision"/><bpmn:sequenceFlow id="F_L20" sourceRef="Task_RecordDecision" targetRef="Send_Result"/><bpmn:sequenceFlow id="F_L21" sourceRef="Send_Result" targetRef="End_LI"/>
  </bpmn:process>
  <bpmn:process id="Process_Sources" isExecutable="false">
    <bpmn:startEvent id="Start_SourceQuery" name="Scoped query received"><bpmn:messageEventDefinition messageRef="Msg_SourceQuery"/></bpmn:startEvent><bpmn:task id="Task_ResolveSources" name="Resolve only authorized source adapters"/><bpmn:task id="Task_ReadWindow" name="Read immutable source artefacts in evidence window"/><bpmn:sendTask id="Send_SourceRecords" name="Return source records and provenance" messageRef="Msg_SourceRecords"/><bpmn:endEvent id="End_Sources" name="Source query complete"/><bpmn:dataStoreReference id="DSR_Source" name="Source artefacts" dataStoreRef="Store_Source"/><bpmn:sequenceFlow id="F_S1" sourceRef="Start_SourceQuery" targetRef="Task_ResolveSources"/><bpmn:sequenceFlow id="F_S2" sourceRef="Task_ResolveSources" targetRef="Task_ReadWindow"/><bpmn:sequenceFlow id="F_S3" sourceRef="Task_ReadWindow" targetRef="Send_SourceRecords"/><bpmn:sequenceFlow id="F_S4" sourceRef="Send_SourceRecords" targetRef="End_Sources"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Acquisition"><bpmndi:BPMNPlane id="Plane_Acquisition" bpmnElement="Collab_UC4_Acquisition">
    <bpmndi:BPMNShape id="Sh_RequestObject" bpmnElement="DOR_AcquisitionRequest"><dc:Bounds x="1520" y="55" width="36" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_AuthObject" bpmnElement="DOR_Authorization"><dc:Bounds x="1020" y="230" width="36" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_DecisionObject" bpmnElement="DOR_PolicyDecision"><dc:Bounds x="1730" y="745" width="36" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sh_PI" bpmnElement="Participant_Investigator" isHorizontal="true"><dc:Bounds x="30" y="20" width="2250" height="150"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_SI" bpmnElement="Start_Investigator"><dc:Bounds x="70" y="77" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_Draft" bpmnElement="Task_DraftScope"><dc:Bounds x="140" y="55" width="160" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_SendAR" bpmnElement="Send_AuthRequest"><dc:Bounds x="340" y="55" width="150" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_CatchAuth" bpmnElement="Catch_Authorization"><dc:Bounds x="540" y="77" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_Bind" bpmnElement="Task_BindRequest"><dc:Bounds x="620" y="55" width="160" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_SendAcq" bpmnElement="Send_AcqRequest"><dc:Bounds x="820" y="55" width="160" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_CatchResult" bpmnElement="Catch_Result"><dc:Bounds x="1030" y="77" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_GWResult" bpmnElement="GW_ResultAllowed" isMarkerVisible="true"><dc:Bounds x="1110" y="70" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_Accept" bpmnElement="Task_AcceptCandidates"><dc:Bounds x="1210" y="30" width="180" height="60"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_Denial" bpmnElement="Task_AcceptDenial"><dc:Bounds x="1210" y="105" width="180" height="55"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_EndAllow" bpmnElement="End_Allowed"><dc:Bounds x="1440" y="42" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_EndDeny" bpmnElement="End_Denied"><dc:Bounds x="1440" y="115" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sh_PA" bpmnElement="Participant_Authority" isHorizontal="true"><dc:Bounds x="30" y="190" width="2250" height="160"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_SA" bpmnElement="Start_Authority"><dc:Bounds x="70" y="252" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_ReviewLegal" bpmnElement="Task_ReviewLegalBasis"><dc:Bounds x="150" y="230" width="180" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_GWIssue" bpmnElement="GW_IssueAuth" isMarkerVisible="true"><dc:Bounds x="380" y="245" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_CreateAuth" bpmnElement="Task_CreateAuthorization"><dc:Bounds x="480" y="200" width="180" height="65"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_Refusal" bpmnElement="Task_CreateRefusal"><dc:Bounds x="480" y="280" width="180" height="60"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_SendAuth" bpmnElement="Send_Authorization"><dc:Bounds x="710" y="230" width="170" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_EndAuth" bpmnElement="End_Authority"><dc:Bounds x="930" y="252" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sh_PLI" bpmnElement="Participant_LI" isHorizontal="true"><dc:Bounds x="30" y="370" width="2250" height="420"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_LPolicy" bpmnElement="Lane_Policy" isHorizontal="true"><dc:Bounds x="60" y="370" width="2220" height="140"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_LAcq" bpmnElement="Lane_Acquisition" isHorizontal="true"><dc:Bounds x="60" y="510" width="2220" height="140"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_LAudit" bpmnElement="Lane_Audit" isHorizontal="true"><dc:Bounds x="60" y="650" width="2220" height="140"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sh_SL" bpmnElement="Start_LI"><dc:Bounds x="80" y="422" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_Authn" bpmnElement="Task_Authenticate"><dc:Bounds x="150" y="400" width="150" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_GWAuthn" bpmnElement="GW_Authenticated" isMarkerVisible="true"><dc:Bounds x="340" y="415" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_Verify" bpmnElement="Task_VerifyAuthorization"><dc:Bounds x="430" y="400" width="175" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_GWValid" bpmnElement="GW_AuthValid" isMarkerVisible="true"><dc:Bounds x="645" y="415" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_Scope" bpmnElement="Task_CheckScope"><dc:Bounds x="735" y="400" width="170" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_GWScope" bpmnElement="GW_InScope" isMarkerVisible="true"><dc:Bounds x="945" y="415" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_Deny" bpmnElement="Task_Deny"><dc:Bounds x="1050" y="405" width="160" height="70"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sh_SendQuery" bpmnElement="Send_SourceQuery"><dc:Bounds x="1040" y="540" width="170" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_CatchRecords" bpmnElement="Catch_SourceRecords"><dc:Bounds x="1260" y="562" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_BExpiry" bpmnElement="Boundary_AuthExpiry"><dc:Bounds x="1245" y="590" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_BTimeout" bpmnElement="Boundary_SourceTimeout"><dc:Bounds x="1280" y="590" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_Min" bpmnElement="Task_Minimize"><dc:Bounds x="1340" y="540" width="170" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_GWNon" bpmnElement="GW_NonEmpty" isMarkerVisible="true"><dc:Bounds x="1550" y="555" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_Package" bpmnElement="Task_PackageCandidates"><dc:Bounds x="1640" y="540" width="180" height="80"/></bpmndi:BPMNShape>
