<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_UC4_Incident" targetNamespace="https://salus-project.eu/mathsim/uc4/incident">
  <bpmn:message id="Msg_Entry" name="Unauthorized physical entry" />
  <bpmn:message id="Msg_Tamper" name="Device tamper action" />
  <bpmn:message id="Msg_SourceRecord" name="Observable source record" />
  <bpmn:error id="Error_SourceUnavailable" name="Source service unavailable" errorCode="UC4-SOURCE-UNAVAILABLE" />
  <bpmn:dataStore id="Store_HAHistory" name="Bounded Home Assistant history" />
  <bpmn:dataStore id="Store_CPERecords" name="Bounded CPE records" />
  <bpmn:collaboration id="Collab_UC4_Incident">
    <bpmn:participant id="Participant_Actor" name="Unauthorized actor (UC4-A05; synthetic)" processRef="Process_Actor" />
    <bpmn:participant id="Participant_Home" name="Physical devices and Home Assistant (UC4-D02/D03/D04/D06)" processRef="Process_Home" />
    <bpmn:participant id="Participant_CPE" name="CPE observation and digital twin (UC4-D01/S06)" processRef="Process_CPE" />
    <bpmn:messageFlow id="MF_Entry" sourceRef="Send_Entry" targetRef="Start_Entry" />
    <bpmn:messageFlow id="MF_Tamper" sourceRef="Send_Tamper" targetRef="Catch_Tamper" />
    <bpmn:messageFlow id="MF_SourceRecord" sourceRef="Send_SourceRecord" targetRef="Start_CPERecord" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Actor" isExecutable="false">
    <bpmn:startEvent id="Start_Actor" name="Incident begins" />
    <bpmn:task id="Task_Enter" name="Cross premises boundary" />
    <bpmn:sendTask id="Send_Entry" name="Cause door opening" messageRef="Msg_Entry" />
    <bpmn:task id="Task_SelectTamper" name="Select configured tamper target/action" />
    <bpmn:sendTask id="Send_Tamper" name="Perform tamper action" messageRef="Msg_Tamper" />
    <bpmn:endEvent id="End_Actor" name="Physical incident complete" />
    <bpmn:sequenceFlow id="F_A1" sourceRef="Start_Actor" targetRef="Task_Enter" />
    <bpmn:sequenceFlow id="F_A2" sourceRef="Task_Enter" targetRef="Send_Entry" />
    <bpmn:sequenceFlow id="F_A3" sourceRef="Send_Entry" targetRef="Task_SelectTamper" />
    <bpmn:sequenceFlow id="F_A4" sourceRef="Task_SelectTamper" targetRef="Send_Tamper" />
    <bpmn:sequenceFlow id="F_A5" sourceRef="Send_Tamper" targetRef="End_Actor" />
  </bpmn:process>
  <bpmn:process id="Process_Home" isExecutable="false">
    <bpmn:startEvent id="Start_Entry" name="Door physically opened"><bpmn:messageEventDefinition messageRef="Msg_Entry" /></bpmn:startEvent>
    <bpmn:task id="Task_SetDoorTruth" name="Set latent door state open" />
    <bpmn:exclusiveGateway id="GW_DoorObserved" name="Door event observed?" default="F_H4_Missed" />
    <bpmn:task id="Task_EmitDoor" name="Emit door state event" />
    <bpmn:task id="Task_RecordDoorMiss" name="Record unobserved door transition" />
    <bpmn:exclusiveGateway id="GW_PresenceDetect" name="Presence detected in evaluation window?" default="F_H7_Missed" />
    <bpmn:task id="Task_EmitPresence" name="Emit presence event" />
    <bpmn:task id="Task_RecordPresenceMiss" name="Record presence false negative" />
    <bpmn:exclusiveGateway id="GW_AutomationFire" name="Door automation has input?" default="F_H10_No" />
    <bpmn:task id="Task_LightCommand" name="Command light on and record result" />
    <bpmn:task id="Task_NoAutomation" name="Preserve absence of automation trace" />
    <bpmn:intermediateCatchEvent id="Catch_Tamper" name="Receive configured tamper action"><bpmn:messageEventDefinition messageRef="Msg_Tamper" /></bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="GW_TamperVisible" name="Tamper telemetry available?" default="F_H14_Hidden" />
    <bpmn:task id="Task_EmitTamper" name="Emit tamper event then mark device offline" />
    <bpmn:task id="Task_OnlyOffline" name="Mark device offline without tamper event" />
    <bpmn:sendTask id="Send_SourceRecord" name="Publish observable records only" messageRef="Msg_SourceRecord" />
    <bpmn:task id="Task_HAUnavailableAudit" name="Record HA source unavailability" />
    <bpmn:endEvent id="End_Home" name="Incident traces finalized" />
    <bpmn:boundaryEvent id="Boundary_HAUnavailable" name="HA unavailable" attachedToRef="Send_SourceRecord"><bpmn:errorEventDefinition errorRef="Error_SourceUnavailable" /></bpmn:boundaryEvent>
    <bpmn:dataStoreReference id="DSR_HAHistory" name="HA event history" dataStoreRef="Store_HAHistory" />
    <bpmn:sequenceFlow id="F_H1" sourceRef="Start_Entry" targetRef="Task_SetDoorTruth" /><bpmn:sequenceFlow id="F_H2" sourceRef="Task_SetDoorTruth" targetRef="GW_DoorObserved" />
    <bpmn:sequenceFlow id="F_H3_Seen" name="sampled and delivered" sourceRef="GW_DoorObserved" targetRef="Task_EmitDoor"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Bernoulli(p_door)=1 and device.online</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_H4_Missed" name="missed/default" sourceRef="GW_DoorObserved" targetRef="Task_RecordDoorMiss" /><bpmn:sequenceFlow id="F_H5" sourceRef="Task_EmitDoor" targetRef="GW_PresenceDetect" /><bpmn:sequenceFlow id="F_H6" sourceRef="Task_RecordDoorMiss" targetRef="GW_PresenceDetect" />
    <bpmn:sequenceFlow id="F_H7_Seen" name="detected" sourceRef="GW_PresenceDetect" targetRef="Task_EmitPresence"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Bernoulli(p_presence)=1 within 1 s</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_H7_Missed" name="missed/default" sourceRef="GW_PresenceDetect" targetRef="Task_RecordPresenceMiss" /><bpmn:sequenceFlow id="F_H8" sourceRef="Task_EmitPresence" targetRef="GW_AutomationFire" /><bpmn:sequenceFlow id="F_H9" sourceRef="Task_RecordPresenceMiss" targetRef="GW_AutomationFire" />
    <bpmn:sequenceFlow id="F_H10_Yes" name="door event available" sourceRef="GW_AutomationFire" targetRef="Task_LightCommand"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">door_event.observed and R_light=1</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_H10_No" name="no/default" sourceRef="GW_AutomationFire" targetRef="Task_NoAutomation" /><bpmn:sequenceFlow id="F_H11" sourceRef="Task_LightCommand" targetRef="Catch_Tamper" /><bpmn:sequenceFlow id="F_H12" sourceRef="Task_NoAutomation" targetRef="Catch_Tamper" /><bpmn:sequenceFlow id="F_H13" sourceRef="Catch_Tamper" targetRef="GW_TamperVisible" />
    <bpmn:sequenceFlow id="F_H14_Visible" name="supported" sourceRef="GW_TamperVisible" targetRef="Task_EmitTamper"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">target.capabilities contains tamper_detection</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_H14_Hidden" name="unsupported/default" sourceRef="GW_TamperVisible" targetRef="Task_OnlyOffline" /><bpmn:sequenceFlow id="F_H15" sourceRef="Task_EmitTamper" targetRef="Send_SourceRecord" /><bpmn:sequenceFlow id="F_H16" sourceRef="Task_OnlyOffline" targetRef="Send_SourceRecord" /><bpmn:sequenceFlow id="F_H17" sourceRef="Send_SourceRecord" targetRef="End_Home" /><bpmn:sequenceFlow id="F_H18_Error" sourceRef="Boundary_HAUnavailable" targetRef="Task_HAUnavailableAudit" /><bpmn:sequenceFlow id="F_H19" sourceRef="Task_HAUnavailableAudit" targetRef="End_Home" />
  </bpmn:process>
  <bpmn:process id="Process_CPE" isExecutable="false">
    <bpmn:startEvent id="Start_CPERecord" name="Observable record arrives"><bpmn:messageEventDefinition messageRef="Msg_SourceRecord" /></bpmn:startEvent>
    <bpmn:task id="Task_ObserveMetadata" name="Create CPE flow/log observation" />
    <bpmn:exclusiveGateway id="GW_RecordRetained" name="Queue and retention permit record?" default="F_C3_Drop" />
    <bpmn:task id="Task_RetainIncident" name="Retain source artefact and update twin" />
    <bpmn:task id="Task_RecordIncidentLoss" name="Increment explicit observation-loss counter" />
    <bpmn:endEvent id="End_CPEIncident" name="CPE incident observation complete" />
    <bpmn:dataStoreReference id="DSR_CPERecords" name="CPE source records" dataStoreRef="Store_CPERecords" />
    <bpmn:sequenceFlow id="F_C1" sourceRef="Start_CPERecord" targetRef="Task_ObserveMetadata" /><bpmn:sequenceFlow id="F_C2" sourceRef="Task_ObserveMetadata" targetRef="GW_RecordRetained" />
    <bpmn:sequenceFlow id="F_C3_Keep" name="retained" sourceRef="GW_RecordRetained" targetRef="Task_RetainIncident"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">queue &lt; capacity and within retention</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_C3_Drop" name="drop/default" sourceRef="GW_RecordRetained" targetRef="Task_RecordIncidentLoss" /><bpmn:sequenceFlow id="F_C4" sourceRef="Task_RetainIncident" targetRef="End_CPEIncident" /><bpmn:sequenceFlow id="F_C5" sourceRef="Task_RecordIncidentLoss" targetRef="End_CPEIncident" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Incident"><bpmndi:BPMNPlane id="Plane_Incident" bpmnElement="Collab_UC4_Incident">
    <bpmndi:BPMNShape id="Sh_PActor" bpmnElement="Participant_Actor" isHorizontal="true"><dc:Bounds x="40" y="30" width="1840" height="140" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sh_StartA" bpmnElement="Start_Actor"><dc:Bounds x="90" y="82" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_Enter" bpmnElement="Task_Enter"><dc:Bounds x="170" y="60" width="140" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_SendEntry" bpmnElement="Send_Entry"><dc:Bounds x="350" y="60" width="140" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_Select" bpmnElement="Task_SelectTamper"><dc:Bounds x="530" y="60" width="160" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_SendTamper" bpmnElement="Send_Tamper"><dc:Bounds x="730" y="60" width="140" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_EndA" bpmnElement="End_Actor"><dc:Bounds x="920" y="82" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sh_PHome" bpmnElement="Participant_Home" isHorizontal="true"><dc:Bounds x="40" y="190" width="1840" height="300" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sh_StartEntry" bpmnElement="Start_Entry"><dc:Bounds x="80" y="322" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_Truth" bpmnElement="Task_SetDoorTruth"><dc:Bounds x="145" y="300" width="130" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_GWDoor" bpmnElement="GW_DoorObserved" isMarkerVisible="true"><dc:Bounds x="310" y="315" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_EmitDoor" bpmnElement="Task_EmitDoor"><dc:Bounds x="400" y="245" width="125" height="65" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_MissDoor" bpmnElement="Task_RecordDoorMiss"><dc:Bounds x="400" y="375" width="125" height="65" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_GWPresence" bpmnElement="GW_PresenceDetect" isMarkerVisible="true"><dc:Bounds x="565" y="315" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_EmitPresence" bpmnElement="Task_EmitPresence"><dc:Bounds x="650" y="245" width="125" height="65" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_MissPresence" bpmnElement="Task_RecordPresenceMiss"><dc:Bounds x="650" y="375" width="125" height="65" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_GWAuto" bpmnElement="GW_AutomationFire" isMarkerVisible="true"><dc:Bounds x="815" y="315" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_Light" bpmnElement="Task_LightCommand"><dc:Bounds x="900" y="245" width="135" height="65" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_NoAuto" bpmnElement="Task_NoAutomation"><dc:Bounds x="900" y="375" width="135" height="65" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_CatchTamper" bpmnElement="Catch_Tamper"><dc:Bounds x="1070" y="322" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_GWTamper" bpmnElement="GW_TamperVisible" isMarkerVisible="true"><dc:Bounds x="1140" y="315" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_EmitTamper" bpmnElement="Task_EmitTamper"><dc:Bounds x="1230" y="245" width="145" height="65" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_Offline" bpmnElement="Task_OnlyOffline"><dc:Bounds x="1230" y="375" width="145" height="65" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_SendRecord" bpmnElement="Send_SourceRecord"><dc:Bounds x="1420" y="300" width="145" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_BoundaryHA" bpmnElement="Boundary_HAUnavailable"><dc:Bounds x="1480" y="362" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_HAAudit" bpmnElement="Task_HAUnavailableAudit"><dc:Bounds x="1590" y="400" width="145" height="65" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_EndHome" bpmnElement="End_Home"><dc:Bounds x="1780" y="322" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_HAStore" bpmnElement="DSR_HAHistory"><dc:Bounds x="1430" y="205" width="50" height="50" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sh_PCPE" bpmnElement="Participant_CPE" isHorizontal="true"><dc:Bounds x="40" y="510" width="1840" height="180" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_StartC" bpmnElement="Start_CPERecord"><dc:Bounds x="100" y="582" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_Observe" bpmnElement="Task_ObserveMetadata"><dc:Bounds x="180" y="560" width="150" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_GWRetain" bpmnElement="GW_RecordRetained" isMarkerVisible="true"><dc:Bounds x="380" y="575" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_Retain" bpmnElement="Task_RetainIncident"><dc:Bounds x="480" y="530" width="150" height="65" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_Drop" bpmnElement="Task_RecordIncidentLoss"><dc:Bounds x="480" y="620" width="150" height="55" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_EndC" bpmnElement="End_CPEIncident"><dc:Bounds x="690" y="582" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sh_CPEStore" bpmnElement="DSR_CPERecords"><dc:Bounds x="760" y="550" width="50" height="50" /></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="E_A1" bpmnElement="F_A1"><di:waypoint x="126" y="100"/><di:waypoint x="170" y="100"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E_A2" bpmnElement="F_A2"><di:waypoint x="310" y="100"/><di:waypoint x="350" y="100"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E_A3" bpmnElement="F_A3"><di:waypoint x="490" y="100"/><di:waypoint x="530" y="100"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E_A4" bpmnElement="F_A4"><di:waypoint x="690" y="100"/><di:waypoint x="730" y="100"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E_A5" bpmnElement="F_A5"><di:waypoint x="870" y="100"/><di:waypoint x="920" y="100"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="E_H1" bpmnElement="F_H1"><di:waypoint x="116" y="340"/><di:waypoint x="145" y="340"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E_H2" bpmnElement="F_H2"><di:waypoint x="275" y="340"/><di:waypoint x="310" y="340"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E_H3" bpmnElement="F_H3_Seen"><di:waypoint x="335" y="315"/><di:waypoint x="400" y="278"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E_H4" bpmnElement="F_H4_Missed"><di:waypoint x="335" y="365"/><di:waypoint x="400" y="408"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E_H5" bpmnElement="F_H5"><di:waypoint x="525" y="278"/><di:waypoint x="590" y="315"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E_H6" bpmnElement="F_H6"><di:waypoint x="525" y="408"/><di:waypoint x="590" y="365"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E_H7S" bpmnElement="F_H7_Seen"><di:waypoint x="590" y="315"/><di:waypoint x="650" y="278"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E_H7M" bpmnElement="F_H7_Missed"><di:waypoint x="590" y="365"/><di:waypoint x="650" y="408"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E_H8" bpmnElement="F_H8"><di:waypoint x="775" y="278"/><di:waypoint x="840" y="315"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E_H9" bpmnElement="F_H9"><di:waypoint x="775" y="408"/><di:waypoint x="840" y="365"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E_H10Y" bpmnElement="F_H10_Yes"><di:waypoint x="840" y="315"/><di:waypoint x="900" y="278"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E_H10N" bpmnElement="F_H10_No"><di:waypoint x="840" y="365"/><di:waypoint x="900" y="408"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E_H11" bpmnElement="F_H11"><di:waypoint x="1035" y="278"/><di:waypoint x="1088" y="322"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E_H12" bpmnElement="F_H12"><di:waypoint x="1035" y="408"/><di:waypoint x="1088" y="358"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E_H13" bpmnElement="F_H13"><di:waypoint x="1106" y="340"/><di:waypoint x="1140" y="340"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E_H14V" bpmnElement="F_H14_Visible"><di:waypoint x="1165" y="315"/><di:waypoint x="1230" y="278"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E_H14H" bpmnElement="F_H14_Hidden"><di:waypoint x="1165" y="365"/><di:waypoint x="1230" y="408"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E_H15" bpmnElement="F_H15"><di:waypoint x="1375" y="278"/><di:waypoint x="1420" y="340"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E_H16" bpmnElement="F_H16"><di:waypoint x="1375" y="408"/><di:waypoint x="1420" y="340"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E_H17" bpmnElement="F_H17"><di:waypoint x="1565" y="340"/><di:waypoint x="1780" y="340"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E_H18" bpmnElement="F_H18_Error"><di:waypoint x="1498" y="398"/><di:waypoint x="1590" y="432"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E_H19" bpmnElement="F_H19"><di:waypoint x="1735" y="432"/><di:waypoint x="1798" y="358"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="E_C1" bpmnElement="F_C1"><di:waypoint x="136" y="600"/><di:waypoint x="180" y="600"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E_C2" bpmnElement="F_C2"><di:waypoint x="330" y="600"/><di:waypoint x="380" y="600"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E_C3K" bpmnElement="F_C3_Keep"><di:waypoint x="405" y="575"/><di:waypoint x="480" y="562"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E_C3D" bpmnElement="F_C3_Drop"><di:waypoint x="405" y="625"/><di:waypoint x="480" y="648"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E_C4" bpmnElement="F_C4"><di:waypoint x="630" y="562"/><di:waypoint x="690" y="600"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E_C5" bpmnElement="F_C5"><di:waypoint x="630" y="648"/><di:waypoint x="690" y="600"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="E_MFEntry" bpmnElement="MF_Entry"><di:waypoint x="420" y="140"/><di:waypoint x="98" y="322"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E_MFTamper" bpmnElement="MF_Tamper"><di:waypoint x="800" y="140"/><di:waypoint x="1088" y="322"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E_MFRecord" bpmnElement="MF_SourceRecord"><di:waypoint x="1492" y="380"/><di:waypoint x="118" y="582"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
