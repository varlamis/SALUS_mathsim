{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://salus.example/schemas/uc5/entity.schema.json",
  "title": "UC5 Entity",
  "type": "object",
  "additionalProperties": false,
  "required": ["entity_id", "use_case", "name", "entity_class", "designation", "role", "states", "network_zones", "twin_id", "data_sensitivity", "record_status", "source_references", "assumption_ids", "notes"],
  "properties": {
    "entity_id": {"type": "string", "pattern": "^UC5-[A-Z]{1,3}[0-9]{2}$"},
    "use_case": {"const": "UC5"},
    "name": {"type": "string", "minLength": 1},
    "entity_class": {"type": "string", "minLength": 1},
    "designation": {"enum": ["physical", "cyber", "logical", "human", "organisation", "data"]},
    "role": {"type": "string", "minLength": 1},
    "states": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "network_zones": {"type": "array", "items": {"type": "string", "pattern": "^UC5-NZ[0-9]{2}$"}, "uniqueItems": true},
    "twin_id": {"type": ["string", "null"], "pattern": "^UC5-DT[0-9]{2}$"},
    "data_sensitivity": {"enum": ["Low", "Medium", "High", "Critical", "TBD"]},
    "record_status": {"enum": ["proposal", "engineering_decision", "synthetic_default", "assumed", "TBD", "partner_confirmed"]},
    "source_references": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "assumption_ids": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  }
}

