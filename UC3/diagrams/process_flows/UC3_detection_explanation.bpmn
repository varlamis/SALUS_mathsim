<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="UC3Detection" targetNamespace="https://salus.example/uc3"><process id="Detection" isExecutable="false"><startEvent id="Start"/><task id="Collect" name="Collect observed network controller and process features"/><task id="Missing" name="Record missingness"/><task id="Score" name="Apply versioned transparent rules"/><exclusiveGateway id="Threshold" name="Threshold reached?" default="NoAlert"/><task id="Explain" name="Attach feature contributions and alternatives"/><task id="NoAlertTask" name="Record no alert"/><endEvent id="End"/><sequenceFlow id="F1" sourceRef="Start" targetRef="Collect"/><sequenceFlow id="F2" sourceRef="Collect" targetRef="Missing"/><sequenceFlow id="F3" sourceRef="Missing" targetRef="Score"/><sequenceFlow id="F4" sourceRef="Score" targetRef="Threshold"/><sequenceFlow id="NoAlert" sourceRef="Threshold" targetRef="NoAlertTask"/><sequenceFlow id="Alert" sourceRef="Threshold" targetRef="Explain"><conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="tFormalExpression">score at or above threshold</conditionExpression></sequenceFlow><sequenceFlow id="F5" sourceRef="Explain" targetRef="End"/><sequenceFlow id="F6" sourceRef="NoAlertTask" targetRef="End"/></process></definitions>
