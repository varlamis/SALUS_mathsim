<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="UC3Supply" targetNamespace="https://salus.example/uc3"><process id="SupplyAssessment" isExecutable="false"><startEvent id="Start"/><task id="Instantiate" name="Instantiate abstract controller twin"/><task id="Exercise" name="Exercise approved symbolic scenarios"/><task id="Compare" name="Compare expected and observed behavior"/><exclusiveGateway id="Accept" name="Assessment acceptable?" default="Reject"/><task id="Approve" name="Record conditional pre-integration approval"/><task id="RejectTask" name="Reject or request remediation"/><endEvent id="End"/><sequenceFlow id="F1" sourceRef="Start" targetRef="Instantiate"/><sequenceFlow id="F2" sourceRef="Instantiate" targetRef="Exercise"/><sequenceFlow id="F3" sourceRef="Exercise" targetRef="Compare"/><sequenceFlow id="F4" sourceRef="Compare" targetRef="Accept"/><sequenceFlow id="Reject" sourceRef="Accept" targetRef="RejectTask"/><sequenceFlow id="ApproveFlow" sourceRef="Accept" targetRef="Approve"><conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="tFormalExpression">all declared checks pass</conditionExpression></sequenceFlow><sequenceFlow id="F5" sourceRef="Approve" targetRef="End"/><sequenceFlow id="F6" sourceRef="RejectTask" targetRef="End"/></process></definitions>
