<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="UC3Evidence" targetNamespace="https://salus.example/uc3"><process id="Evidence" isExecutable="false"><startEvent id="Start"/><task id="Scope" name="Authorize purpose scope and window"/><task id="Minimize" name="Minimize observable metadata"/><task id="Hash" name="Canonicalize hash and register custody"/><task id="Verify" name="Verify integrity and custody"/><exclusiveGateway id="Valid" name="Valid?" default="Quarantine"/><task id="Reconstruct" name="Build qualified claims with alternatives"/><task id="QuarantineTask" name="Quarantine invalid evidence"/><endEvent id="End"/><sequenceFlow id="F1" sourceRef="Start" targetRef="Scope"/><sequenceFlow id="F2" sourceRef="Scope" targetRef="Minimize"/><sequenceFlow id="F3" sourceRef="Minimize" targetRef="Hash"/><sequenceFlow id="F4" sourceRef="Hash" targetRef="Verify"/><sequenceFlow id="F5" sourceRef="Verify" targetRef="Valid"/><sequenceFlow id="Quarantine" sourceRef="Valid" targetRef="QuarantineTask"/><sequenceFlow id="Use" sourceRef="Valid" targetRef="Reconstruct"><conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="tFormalExpression">integrity and custody valid</conditionExpression></sequenceFlow><sequenceFlow id="F6" sourceRef="Reconstruct" targetRef="End"/><sequenceFlow id="F7" sourceRef="QuarantineTask" targetRef="End"/></process></definitions>
