<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="UC3Attack" targetNamespace="https://salus.example/uc3"><process id="Attack" isExecutable="false"><startEvent id="Start"/><task id="Discover" name="Emit symbolic discovery requests"/><task id="Fuzz" name="Emit bounded abstract fuzz events"/><task id="Write" name="Attempt unauthorized abstract write"/><task id="Validate" name="Parse support and authorize"/><exclusiveGateway id="Accepted" name="Accepted?" default="RejectFlow"/><task id="Reject" name="Reject and audit"/><task id="Bound" name="Apply PLC interlocks"/><endEvent id="End"/><sequenceFlow id="F1" sourceRef="Start" targetRef="Discover"/><sequenceFlow id="F2" sourceRef="Discover" targetRef="Fuzz"/><sequenceFlow id="F3" sourceRef="Fuzz" targetRef="Write"/><sequenceFlow id="F4" sourceRef="Write" targetRef="Validate"/><sequenceFlow id="F5" sourceRef="Validate" targetRef="Accepted"/><sequenceFlow id="RejectFlow" sourceRef="Accepted" targetRef="Reject"/><sequenceFlow id="AcceptFlow" sourceRef="Accepted" targetRef="Bound"><conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="tFormalExpression">authorized and supported</conditionExpression></sequenceFlow><sequenceFlow id="F6" sourceRef="Reject" targetRef="End"/><sequenceFlow id="F7" sourceRef="Bound" targetRef="End"/></process></definitions>
