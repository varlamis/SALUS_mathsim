<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="UC3Mitigation" targetNamespace="https://salus.example/uc3"><process id="Mitigation" isExecutable="false"><startEvent id="Start"/><task id="Select" name="Select candidate policy"/><task id="Check" name="Check capability safety telemetry and authority"/><exclusiveGateway id="Eligible" name="Eligible?" default="Reject"/><task id="Apply" name="Request and verify abstract enforcement"/><task id="Rejected" name="Reject or require human review"/><task id="Recover" name="Observe effect expire and roll back"/><endEvent id="End"/><sequenceFlow id="F1" sourceRef="Start" targetRef="Select"/><sequenceFlow id="F2" sourceRef="Select" targetRef="Check"/><sequenceFlow id="F3" sourceRef="Check" targetRef="Eligible"/><sequenceFlow id="Reject" sourceRef="Eligible" targetRef="Rejected"/><sequenceFlow id="Allow" sourceRef="Eligible" targetRef="Apply"><conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="tFormalExpression">capable and safe and authorized</conditionExpression></sequenceFlow><sequenceFlow id="F4" sourceRef="Apply" targetRef="Recover"/><sequenceFlow id="F5" sourceRef="Recover" targetRef="End"/><sequenceFlow id="F6" sourceRef="Rejected" targetRef="End"/></process></definitions>
