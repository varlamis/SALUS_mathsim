<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="UC3Lifecycle" targetNamespace="https://salus.example/uc3"><process id="Lifecycle" isExecutable="false"><startEvent id="Start"/><task id="Normal" name="Operational and synchronized"/><exclusiveGateway id="Change" name="Fault attack or stale update?" default="Remain"/><task id="Degraded" name="Degraded isolated safe or stale"/><task id="Recover" name="Validate recovery and resynchronize"/><endEvent id="End"/><sequenceFlow id="F1" sourceRef="Start" targetRef="Normal"/><sequenceFlow id="F2" sourceRef="Normal" targetRef="Change"/><sequenceFlow id="Remain" sourceRef="Change" targetRef="End"/><sequenceFlow id="Transition" sourceRef="Change" targetRef="Degraded"><conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="tFormalExpression">state change observed</conditionExpression></sequenceFlow><sequenceFlow id="F3" sourceRef="Degraded" targetRef="Recover"/><sequenceFlow id="F4" sourceRef="Recover" targetRef="End"/></process></definitions>
