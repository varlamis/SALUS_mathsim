{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://salus.example/schemas/uc1/event.schema.json",
  "title": "SALUS UC1 Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "event_time", "ingest_time", "source_entity", "target_entity", "message_id", "payload_hash", "attributes", "observable"],
  "properties": {
    "event_id": {"type": "string", "pattern": "^UC1-EVT-[0-9]{6}$"},
    "event_type": {"type": "string", "minLength": 1},
    "event_time": {"type": "number", "minimum": 0},
    "ingest_time": {"type": "number", "minimum": 0},
    "source_entity": {"type": "string", "pattern": "^UC1(?:-[A-Z]+[0-9]{2})?$"},
    "target_entity": {"type": "string", "pattern": "^UC1(?:-[A-Z]+[0-9]{2})?$"},
    "message_id": {"type": ["string", "null"]},
    "payload_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "attributes": {"type": "object"},
    "observable": {"type": "boolean"}
  }
}

