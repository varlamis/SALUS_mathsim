{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://salus.example/schemas/uc1/simulation_config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "description", "seed", "duration_seconds", "attack", "channel", "trust", "detection", "policy", "controller", "evidence", "clocks", "outputs"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "scenario_id": {"type": "string", "pattern": "^UC1-"},
    "description": {"type": "string"},
    "seed": {"type": "integer", "minimum": 0},
    "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
    "attack": {"$ref": "#/$defs/attack"},
    "channel": {"$ref": "#/$defs/channel"},
    "trust": {"$ref": "#/$defs/trust"},
    "detection": {"$ref": "#/$defs/detection"},
    "policy": {"$ref": "#/$defs/policy"},
    "controller": {"$ref": "#/$defs/controller"},
    "evidence": {"$ref": "#/$defs/evidence"},
    "clocks": {"type": "object", "additionalProperties": {"type": "number"}},
    "outputs": {"type": "object", "additionalProperties": false, "required": ["directory"], "properties": {"directory": {"type": "string", "pattern": "^reports/generated/uc1/"}}}
  },
  "$defs": {
    "attack": {"type": "object", "additionalProperties": false, "required": ["enabled", "kind", "start_seconds", "count", "interval_seconds", "credential_state", "replay_age_seconds"], "properties": {"enabled": {"type": "boolean"}, "kind": {"enum": ["forged_request", "replay", "flood", "malformed", "sequence_anomaly"]}, "start_seconds": {"type": "number", "minimum": 0}, "count": {"type": "integer", "minimum": 1}, "interval_seconds": {"type": "number", "exclusiveMinimum": 0}, "credential_state": {"enum": ["valid", "untrusted", "expired", "revoked"]}, "replay_age_seconds": {"type": "number", "minimum": 0}}},
    "channel": {"type": "object", "additionalProperties": false, "required": ["capacity_messages_per_second", "buffer_messages", "base_delay_seconds", "jitter_seconds", "loss_probability", "observation_probability"], "properties": {"capacity_messages_per_second": {"type": "number", "exclusiveMinimum": 0}, "buffer_messages": {"type": "integer", "minimum": 1}, "base_delay_seconds": {"type": "number", "minimum": 0}, "jitter_seconds": {"type": "number", "minimum": 0}, "loss_probability": {"type": "number", "minimum": 0, "maximum": 1}, "observation_probability": {"type": "number", "minimum": 0, "maximum": 1}}},
    "trust": {"type": "object", "additionalProperties": false, "required": ["service_available", "freshness_window_seconds", "valid_sender"], "properties": {"service_available": {"type": "boolean"}, "freshness_window_seconds": {"type": "number", "minimum": 0}, "valid_sender": {"type": "string"}}},
    "detection": {"type": "object", "additionalProperties": false, "required": ["threshold", "weights"], "properties": {"threshold": {"type": "number", "minimum": 0, "maximum": 1}, "weights": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}}}},
    "policy": {"type": "object", "additionalProperties": false, "required": ["supported_actions", "selected_action", "enforcement_available", "enforcement_delay_seconds"], "properties": {"supported_actions": {"type": "array", "items": {"enum": ["drop", "rate_limit", "isolate", "alert_only"]}, "uniqueItems": true}, "selected_action": {"enum": ["drop", "rate_limit", "isolate", "alert_only"]}, "enforcement_available": {"type": "boolean"}, "enforcement_delay_seconds": {"type": "number", "minimum": 0}}},
    "controller": {"type": "object", "additionalProperties": false, "required": ["initial_phase", "minimum_phase_seconds", "allow_control_requests"], "properties": {"initial_phase": {"enum": ["safe_all_red", "north_south", "east_west"]}, "minimum_phase_seconds": {"type": "number", "exclusiveMinimum": 0}, "allow_control_requests": {"type": "boolean"}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["enabled", "allowed_types", "allowed_fields", "retention_seconds"], "properties": {"enabled": {"type": "boolean"}, "allowed_types": {"type": "array", "items": {"type": "string"}}, "allowed_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "retention_seconds": {"type": "number", "minimum": 0}}}
  }
}

