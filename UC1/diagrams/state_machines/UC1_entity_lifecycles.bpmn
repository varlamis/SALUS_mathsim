<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="https://salus.example/uc1">
  <process id="UC1_EntityLifecycles" isExecutable="false"><startEvent id="Start"/><task id="Operational" name="Operational state"/><task id="Degraded" name="Degraded or isolated state"/><task id="Recovered" name="Safe recovered state"/><endEvent id="End"/><sequenceFlow id="F1" sourceRef="Start" targetRef="Operational"/><sequenceFlow id="F2" sourceRef="Operational" targetRef="Degraded"/><sequenceFlow id="F3" sourceRef="Degraded" targetRef="Recovered"/><sequenceFlow id="F4" sourceRef="Recovered" targetRef="End"/></process>
</definitions>

