<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="https://salus.example/uc1">
  <process id="UC1_SystemCollaboration" isExecutable="false">
    <startEvent id="Start"/><task id="Exchange" name="Exchange abstract Car2X message"/><task id="Observe" name="Observe and validate"/><task id="Respond" name="Detect, mitigate, and preserve"/><endEvent id="End"/>
    <sequenceFlow id="F1" sourceRef="Start" targetRef="Exchange"/><sequenceFlow id="F2" sourceRef="Exchange" targetRef="Observe"/><sequenceFlow id="F3" sourceRef="Observe" targetRef="Respond"/><sequenceFlow id="F4" sourceRef="Respond" targetRef="End"/>
  </process>
</definitions>

